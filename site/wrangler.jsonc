{
  // The Worker's own name (not shown to visitors; the site's name is in src/lib/site.ts).
  "name": "rigel-archive",
  // The Astro site plus the scheduled jobs and the processing container (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The site's own domain (src/lib/hosts.ts): the public site at rigeltheatre.fans, the admin at
  // admin.rigeltheatre.fans (the whole host behind Cloudflare Access), www sent on to the domain. Custom
  // domains: `wrangler deploy` makes their DNS records and certificates in the rigeltheatre.fans zone.
  "routes": [
    { "pattern": "rigeltheatre.fans", "custom_domain": true },
    { "pattern": "www.rigeltheatre.fans", "custom_domain": true },
    { "pattern": "admin.rigeltheatre.fans", "custom_domain": true }
  ],
  // The workers.dev address was the private preview before the domain; it is off, as are version preview
  // URLs: every deployment is reached through the hosts above only.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // A whole edition downloads as a zip made on the fly (CRC-32 of every byte, ~6 s of CPU for 2 GB);
  // CPU time is billed as used, so the higher ceiling costs nothing by itself.
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rigel-archive",
      // From `wrangler d1 create rigel-archive --location apac`; local dev ignores it.
      "database_id": "b75b91c5-ad17-44ea-938e-84eff3bac9aa",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rigel-archive-media" }
  ],
  // The processing program (tools/ra, `ra container`) in a Cloudflare container, one instance, started
  // by the Processor Durable Object when there is work (src/processor.ts). `wrangler deploy` builds the
  // image from tools/ra/Dockerfile with the local Docker. standard-4: 4 vCPU, 12 GiB, 20 GB disk (video
  // transcodes, unpacking large archives).
  "containers": [
    {
      "class_name": "Processor",
      "image": "../tools/ra/Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROCESSOR", "class_name": "Processor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Processor"] }],
  // src/lib/schedule.ts: look for waiting work every 10 minutes; the backup at 04:17 Japan time.
  "triggers": { "crons": ["*/10 * * * *", "17 19 * * *"] },
  "vars": {
    // The hosts above, by role (src/lib/hosts.ts); any other host (astro dev, the container) serves both.
    "PUBLIC_HOST": "rigeltheatre.fans",
    "ADMIN_HOST": "admin.rigeltheatre.fans",
    // Cloudflare Access (Zero Trust) for /admin: team domain and the AUD tag of the Access application that
    // covers admin.rigeltheatre.fans (not secrets; several may be given, comma-separated).
    // Empty = the admin answers 403 to everyone except in `astro dev`.
    "ACCESS_TEAM_DOMAIN": "rigel-archive.cloudflareaccess.com",
    "ACCESS_AUD": "1139debb0ccd28a30f93ccba2440739de0c88490d2c70201eb8b7762475d483e",
    // Base URL of `uv run ra serve` for admin previews; set in .dev.vars for local development only.
    "MEDIA_DEV_BASE": "",
    // Days a deleted file's stored content is kept (so the deletion can be undone) before cleanup.
    "STORAGE_GRACE_DAYS": "30"
  }
  // Secrets, not vars (production: `wrangler secret put`; local: .dev.vars):
  //   WORKER_TOKEN            lets `uv run ra worker` call /admin/api/worker/* (the container needs none)
  //   B2_KEY_ID, B2_APP_KEY, B2_BUCKET, BACKUP_CRYPT_PASSWORD, BACKUP_CRYPT_SALT
  //                           the encrypted backup (tools/ra/backup.env; `npm run secrets:backup`)
}

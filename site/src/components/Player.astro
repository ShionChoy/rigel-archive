---
// The player at the bottom of the page (设计文档「公开站方案 · 播放器」). On the public site it lives in
// layouts/Site.astro with transition:persist, so it keeps playing while visitors move between pages; the
// admin's 预览公开页 has one too. Pages offer tracks with data attributes (components/ReleaseView.astro):
//
//   [data-queue]                a list of tracks; its [data-track] rows are the queue when one is played
//   [data-track]='{…}'          a track: file, title, sub, album, cover, href, sources, exp
//   [data-play]                 plays the track it is in (from there to the end of its list)
//   [data-play-all="#sel"]      plays the list `sel` from the start
//   [data-play-random]          plays a random track (/api/random)
//
// What it does lives in scripts/player.ts; the texts it needs come with it (data-labels), in the page's language.
// Its cover opens 正在播放 (#now-playing, scripts/now-playing.ts): the track at full size with its lyrics,
// whose details come from `info` (the public site's /api/track, or the admin's for 预览公开页).
interface Props { info?: string }
const { info = '/api/track' } = Astro.props;
const { t } = Astro.locals;
const npLabels = { unsynced: t('歌词未与音乐同步') };
const labels = {
  play: t('播放'),
  pause: t('暂停'),
  lossless: t('无损'),
  original: t('原件'),
  saver: t('省流'),
  clip: t('试听'),
  versions: t('播放版本 · 本曲'),
  versionsTitle: t('选择播放版本'),
  losslessHint: t('推流用的无损压缩版，与原件逐采样一致'),
  losslessOtherHint: t('推流用的无损版'),
  originalHint: t('收录时的原始文件'),
  saverHint: t('有损，流量最小'),
  clipHint: t('只能试听这一段'),
  locked: t('这一版本未开放'),
  defaultMark: t('默认'),
  remember: t('选择记在这台设备上，之后的曲目也按它挑；没有这一版本的曲目播无损。'),
  repeatOff: t('不循环'),
  repeatAll: t('循环全部'),
  repeatOne: t('单曲循环'),
  shuffleOn: t('随机播放：开'),
  shuffleOff: t('随机播放：关'),
  failed: t('这一首无法播放，已跳到下一首'),
  slow: t('网络跟不上无损播放，已改为省流；可在播放版本中换回'),
  nothing: t('没有可以播放的曲目'),
};
---

<div id="player" class="player" transition:persist="player" data-labels={JSON.stringify(labels)} hidden>
  <div class="pl-now">
    <button type="button" class="pl-cover-btn" aria-label={t('展开播放页')} title={t('展开播放页')}>
      <img class="pl-cover" alt="" />
      <svg class="pl-expand" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>
    <div class="pl-text">
      <div class="pl-title"></div>
      <div class="pl-sub"></div>
    </div>
  </div>
  <div class="pl-center">
    <div class="pl-buttons">
      <button type="button" class="pl-btn pl-shuffle" aria-pressed="false" title={labels.shuffleOff} aria-label={labels.shuffleOff}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="line"><path d="M4 7h3.2c2 0 3.2 1 4.5 3l1.6 2.5c1.3 2 2.5 3 4.5 3H20M4 17h3.2c1.1 0 2-.3 2.7-1M13.9 8c.8-.6 1.7-1 2.9-1H20M17.5 4.5 20 7l-2.5 2.5M17.5 13 20 15.5 17.5 18" /></svg>
      </button>
      <button type="button" class="pl-btn pl-prev" aria-label={t('上一首')} title={t('上一首')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h2v12H6zM9.5 12 18 6v12z" /></svg>
      </button>
      <button type="button" class="pl-btn pl-toggle" aria-label={labels.play}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-play"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-pause"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
      </button>
      <button type="button" class="pl-btn pl-next" aria-label={t('下一首')} title={t('下一首')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 6h2v12h-2zM6 6l8.5 6L6 18z" /></svg>
      </button>
      <button type="button" class="pl-btn pl-repeat" data-mode="off" title={labels.repeatOff} aria-label={labels.repeatOff}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="line"><path d="M5 11V9.5A3.5 3.5 0 0 1 8.5 6H19M16.5 3.5 19 6l-2.5 2.5M19 13v1.5a3.5 3.5 0 0 1-3.5 3.5H5M7.5 20.5 5 18l2.5-2.5" /></svg>
        <span class="pl-one" aria-hidden="true">1</span>
      </button>
    </div>
    <div class="pl-bar">
      <span class="pl-time pl-cur">0:00</span>
      <input class="pl-seek" type="range" min="0" max="1000" value="0" step="1" aria-label={t('播放进度')} />
      <span class="pl-time pl-dur">0:00</span>
    </div>
  </div>
  <div class="pl-side">
    <button type="button" class="pl-quality" title={labels.versionsTitle} aria-haspopup="true" aria-expanded="false"><span class="pl-format"></span><span class="pl-mode">{labels.lossless}</span></button>
    <button type="button" class="pl-btn pl-queue-btn" aria-expanded="false" aria-label={t('播放队列')} title={t('播放队列')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="line"><path d="M4 6.5h12M4 11.5h12M4 16.5h7M16.5 14.5v6l4.5-3z" /></svg>
    </button>
    <input class="pl-volume" type="range" min="0" max="1" step="0.02" value="1" aria-label={t('音量')} title={t('音量')} />
    <button type="button" class="pl-btn pl-close" aria-label={t('关闭播放器')} title={t('关闭播放器')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="line"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11" /></svg>
    </button>
  </div>
  <div class="pl-queue" hidden>
    <div class="pl-queue-head"><span>{t('播放队列')}</span><button type="button" class="pl-clear">{t('清空')}</button></div>
    <ol></ol>
  </div>
  <div class="pl-qmenu" role="menu" hidden></div>
  <div class="pl-toast" role="status" aria-live="polite"></div>
  <audio preload="none"></audio>
</div>

<section id="now-playing" class="np" transition:persist="now-playing" aria-label={t('正在播放')} data-info={info} data-labels={JSON.stringify(npLabels)} hidden>
  <div class="np-bg" aria-hidden="true"><img alt="" /></div>
  <header class="np-head">
    <button type="button" class="np-close" aria-label={t('收起')} title={t('收起')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </button>
    <div class="np-from">
      <span class="np-kicker">{t('正在播放')}</span>
      <a class="np-album"></a>
    </div>
  </header>
  <div class="np-tabs" role="tablist">
    <button type="button" role="tab" data-np-tab="cover" aria-selected="true">{t('封面')}</button>
    <button type="button" role="tab" data-np-tab="lyrics" aria-selected="false">{t('歌词')}</button>
  </div>
  <div class="np-body">
    <div class="np-main">
      <div class="np-art">
        <img class="np-cover" alt="" />
        <svg class="np-blank" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18.5a2.5 2.5 0 1 1-2.5-2.5H9V6l10-2v11.5a2.5 2.5 0 1 1-2.5-2.5H19" /></svg>
      </div>
      <div class="np-meta">
        <div class="np-title"></div>
        <div class="np-artist"></div>
        <div class="np-credits"></div>
      </div>
    </div>
    <div class="np-lyrics" tabindex="-1">
      <p class="np-note"></p>
      <div class="np-lines"></div>
    </div>
  </div>
  <canvas class="np-wave" aria-hidden="true"></canvas>
</section>

<style is:global>
  body:has(#player:not([hidden])) { padding-bottom: 92px; }
  .player {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; gap: 16px;
    padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
    background: var(--player-bg, var(--card)); color: var(--ink); border-top: 1px solid var(--line);
    box-shadow: 0 -8px 28px rgb(0 0 0 / 0.18); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    font-size: 14px;
  }
  .player[hidden] { display: none; }
  .player a { color: inherit; text-decoration: none; }
  .pl-now { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 10px; align-items: center; min-width: 0; }
  .pl-cover-btn { position: relative; width: 52px; height: 52px; padding: 0; border: 0; border-radius: 6px; overflow: hidden; background: var(--blank); cursor: pointer; display: block; }
  .pl-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pl-cover:not([src]) { visibility: hidden; }
  .pl-expand { position: absolute; inset: 0; margin: auto; width: 26px; height: 26px; padding: 3px; border-radius: 50%; background: rgb(0 0 0 / 0.55); fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity 0.15s; }
  .pl-cover-btn:hover .pl-expand, .pl-cover-btn:focus-visible .pl-expand { opacity: 1; }
  .pl-text { min-width: 0; }
  .pl-title { display: block; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-title a:hover { text-decoration: underline; }
  .pl-sub { color: var(--muted); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-center { display: grid; gap: 2px; justify-items: center; min-width: 0; }
  .pl-buttons { display: flex; align-items: center; gap: 6px; }
  .pl-btn { position: relative; width: 36px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--ink); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .pl-btn:hover { background: var(--now); }
  .pl-btn svg { width: 20px; height: 20px; fill: currentColor; }
  .pl-btn svg.line { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .pl-toggle { width: 42px; height: 42px; background: var(--accent); color: var(--on-accent); }
  .pl-toggle:hover { background: var(--accent); filter: brightness(1.08); }
  .pl-toggle .i-pause, .player.playing .pl-toggle .i-play { display: none; }
  .player.playing .pl-toggle .i-pause { display: block; }
  .pl-shuffle[aria-pressed='true'], .pl-repeat:not([data-mode='off']) { color: var(--accent); }
  .pl-one { position: absolute; right: 5px; bottom: 5px; font-size: 9px; font-weight: 700; display: none; }
  .pl-repeat[data-mode='one'] .pl-one { display: block; }
  .pl-bar { display: grid; grid-template-columns: 3.2em minmax(0, 1fr) 3.2em; gap: 8px; align-items: center; width: 100%; max-width: 560px; }
  .pl-time { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .pl-cur { text-align: right; }
  .pl-seek, .pl-volume { accent-color: var(--accent); width: 100%; margin: 0; }
  .pl-side { display: flex; align-items: center; justify-content: flex-end; gap: 6px; min-width: 0; }
  .pl-quality { border: 1px solid var(--line); background: none; color: var(--muted); border-radius: 14px; padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer; white-space: nowrap; display: flex; gap: 6px; }
  .pl-quality .pl-mode { color: var(--accent); font-weight: 600; }
  .pl-quality.saver .pl-mode { color: var(--muted); }
  .pl-quality[aria-expanded='true'] { border-color: var(--accent); }
  .pl-qmenu { position: absolute; right: 16px; bottom: calc(100% + 8px); width: min(380px, calc(100vw - 32px)); background: var(--card); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.3); padding: 6px; z-index: 3; }
  .pl-qmenu[hidden] { display: none; }
  .pl-qmenu .qm-head { color: var(--muted); font-size: 12px; padding: 6px 10px 8px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
  .pl-qmenu button { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; width: 100%; text-align: left; border: 0; background: none; color: var(--ink); padding: 8px 10px; border-radius: 7px; cursor: pointer; font: inherit; }
  .pl-qmenu button:hover:not(:disabled), .pl-qmenu button.on { background: var(--now); }
  .pl-qmenu button:disabled { opacity: 0.45; cursor: default; }
  .pl-qmenu .qm-dot { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--muted); margin-top: 3px; position: relative; }
  .pl-qmenu button.on .qm-dot { border-color: var(--accent); }
  .pl-qmenu button.on .qm-dot::after { content: ''; position: absolute; inset: 2.5px; border-radius: 50%; background: var(--accent); }
  .pl-qmenu .qm-name { font-weight: 600; }
  .pl-qmenu button.on .qm-name { color: var(--accent); }
  .pl-qmenu .qm-spec { font-size: 12.5px; margin-left: 6px; }
  .pl-qmenu .qm-tag { font-size: 11px; border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; color: var(--muted); margin-left: 6px; }
  .pl-qmenu .qm-hint { display: block; color: var(--muted); font-size: 12px; }
  .pl-qmenu .qm-foot { border-top: 1px solid var(--line); margin-top: 4px; padding: 8px 10px 4px; color: var(--muted); font-size: 12px; }
  .pl-format:empty { display: none; }
  .pl-volume { width: 90px; }
  .pl-queue { position: absolute; right: 16px; bottom: calc(100% + 8px); width: min(420px, calc(100vw - 32px)); max-height: min(60vh, 520px); overflow: auto; background: var(--card); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); }
  .pl-queue-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--card); }
  .pl-clear { border: 0; background: none; color: var(--accent); cursor: pointer; font: inherit; }
  .pl-queue ol { list-style: none; margin: 0; padding: 4px; }
  .pl-queue li button { display: grid; grid-template-columns: 1.8em minmax(0, 1fr); gap: 6px; width: 100%; text-align: left; border: 0; background: none; color: var(--ink); padding: 6px 8px; border-radius: 6px; cursor: pointer; font: inherit; }
  .pl-queue li button:hover { background: var(--now); }
  .pl-queue li.on button { background: var(--now); color: var(--accent); font-weight: 600; }
  .pl-queue .q-n { color: var(--muted); font-variant-numeric: tabular-nums; }
  .pl-queue .q-sub { display: block; color: var(--muted); font-size: 12px; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-toast { position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 6px 14px; border-radius: 16px; font-size: 13px; opacity: 0; pointer-events: none; transition: opacity 0.2s; width: max-content; max-width: min(92vw, 520px); text-align: center; }
  .pl-toast.on { opacity: 1; }
  @media (max-width: 760px) {
    body:has(#player:not([hidden])) { padding-bottom: 76px; }
    .player { grid-template-columns: minmax(0, 1fr) auto auto; gap: 6px; padding: 10px 10px calc(8px + env(safe-area-inset-bottom)); }
    .pl-now { grid-template-columns: 44px minmax(0, 1fr); }
    .pl-cover-btn { width: 44px; height: 44px; }
    .pl-center { display: contents; }
    .pl-buttons { gap: 2px; }
    .pl-shuffle, .pl-repeat, .pl-volume, .pl-close, .pl-format { display: none !important; }
    .pl-bar { position: absolute; left: 0; right: 0; top: -8px; max-width: none; grid-template-columns: minmax(0, 1fr); }
    .pl-bar .pl-time { display: none; }
    .pl-side { gap: 2px; }
    .pl-quality { padding: 3px 8px; }
  }

  /* ------------------------------------------------------------ 正在播放 (scripts/now-playing.ts)
     Always the night palette, whatever the page's theme: the blurred cover gives it its colour. The player
     stays at the bottom as its remote, in the same palette. */
  html.np-open { overflow: hidden; }
  html.np-open .player {
    --ink: #f4f5fa; --muted: rgb(255 255 255 / 0.62); --line: rgb(255 255 255 / 0.14); --card: #171c2e; --bg: #0b0e1a;
    --now: rgb(255 255 255 / 0.1); --accent: #e2c17b; --on-accent: #1b1507; --blank: rgb(255 255 255 / 0.08);
    --player-bg: rgb(6 8 16 / 0.3); border-top-color: rgb(255 255 255 / 0.08); box-shadow: none;
  }
  html.np-open .pl-now { visibility: hidden; }
  .np {
    --accent: #e2c17b;
    position: fixed; inset: 0; z-index: 39; display: flex; flex-direction: column; overflow: hidden; isolation: isolate;
    color: #f4f5fa; background: #0b0e1a; color-scheme: dark;
    opacity: 0; transform: translateY(28px); transition: opacity 0.26s ease, transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .np.on { opacity: 1; transform: none; }
  .np[hidden] { display: none; }
  .np-bg {
    position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background: radial-gradient(900px 640px at 18% 12%, rgb(90 110 200 / 0.38), transparent 70%), radial-gradient(760px 560px at 88% 92%, rgb(226 193 123 / 0.16), transparent 70%), #0b0e1a;
  }
  .np-bg img { position: absolute; inset: -12%; width: 124%; height: 124%; object-fit: cover; filter: blur(64px) saturate(1.5) brightness(0.62); transition: opacity 0.6s; }
  .np-bg img:not([src]) { opacity: 0; }
  .np-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(8 10 20 / 0.2), rgb(8 10 20 / 0.5) 55%, rgb(8 10 20 / 0.78)); }

  .np-head { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; align-items: center; gap: 12px; padding: calc(14px + env(safe-area-inset-top)) 20px 6px; }
  .np-close { width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.1); color: inherit; display: grid; place-items: center; cursor: pointer; padding: 0; transition: background 0.15s; }
  .np-close:hover { background: rgb(255 255 255 / 0.18); }
  .np-close svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .np-from { text-align: center; min-width: 0; line-height: 1.4; }
  .np-kicker { display: block; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(255 255 255 / 0.55); }
  .np-album { display: block; color: inherit; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np-album[href]:hover { color: inherit; text-decoration: underline; }
  .np-tabs { display: none; }

  .np-body {
    flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(240px, 440px) minmax(0, 580px); grid-template-rows: minmax(0, 1fr);
    justify-content: center; align-items: center; gap: clamp(40px, 7vw, 110px);
    padding: 12px 40px calc(var(--pl-h, 92px) + 28px);
  }
  .np-main { display: grid; gap: 26px; min-width: 0; }
  .np-art {
    position: relative; width: min(100%, 46vh); aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: rgb(255 255 255 / 0.07);
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .np-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .np-cover:not([src]) { visibility: hidden; }
  .np-blank { position: absolute; inset: 0; margin: auto; width: 34%; height: 34%; fill: none; stroke: rgb(255 255 255 / 0.35); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .np.no-art .np-blank { display: block; }
  .np-title { font-size: clamp(22px, 2.4vw, 30px); font-weight: 700; line-height: 1.25; letter-spacing: 0.01em; overflow-wrap: anywhere; }
  .np-artist { margin-top: 6px; font-size: 15px; color: rgb(255 255 255 / 0.72); overflow-wrap: anywhere; }
  .np-artist:empty { display: none; }
  .np-credits { display: grid; gap: 3px; margin-top: 14px; font-size: 13px; color: rgb(255 255 255 / 0.84); }
  .np-credits:empty { display: none; }
  .np-credits .k { color: rgb(255 255 255 / 0.5); margin-right: 10px; }

  .np-lyrics {
    position: relative; height: 100%; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; outline: none;
    -webkit-mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
  }
  .np-lyrics::-webkit-scrollbar { display: none; }
  .np-lyrics, .np-credits, .np-artist, .np-body { transition: opacity 0.2s; }
  .np.pending .np-body { opacity: 0; }
  .np.waiting .np-lyrics, .np.waiting .np-credits, .np.waiting .np-artist { opacity: 0; }
  .np:not(.has-lyrics) .np-lyrics { display: none; }
  .np-note { margin: 0; padding-top: 4vh; font-size: 12px; color: rgb(255 255 255 / 0.5); }
  /* Plain lyrics sit in the middle when they are short, and scroll when they are long. */
  .np.has-lyrics:not(.synced) .np-lyrics { display: flex; flex-direction: column; }
  .np.has-lyrics:not(.synced) .np-lyrics > :first-child { margin-top: auto; }
  .np.has-lyrics:not(.synced) .np-lines { margin-bottom: auto; }
  .np-note:empty { display: none; }
  .np-lines { padding: 3vh 0 6vh; }
  .np-line { margin: 0 0 6px; font-size: 19px; font-weight: 600; line-height: 1.6; color: rgb(255 255 255 / 0.86); overflow-wrap: anywhere; }
  .np-break { height: 18px; margin: 0; }

---
import type { LocNode } from '../lib/locations';
import { withParams } from '../lib/format';

interface Props {
  nodes: LocNode[];
  current: string;
  open: Set<string>; // keys on the way to the current place
  url: URL;
}

const { nodes, current, open, url } = Astro.props;
const { t } = Astro.locals;
// Files can be dropped on releases, editions and folders; eras only hold folders.
const droppable = (node: LocNode) => node.kind !== 'era';
const href = (node: LocNode) => withParams(url, { loc: node.key, dir: null, state: 'all', page: null });
const missing = new Set(['missing', 'partial', 'unknown', 'planned']);
---

<ul>
  {
    nodes.map((node) => {
      const link = (
        <a
          class:list={['loc', node.kind, { current: current === node.key, empty: node.n === 0 }]}
          href={href(node)}
          data-loc={node.key}
          data-drop={droppable(node) ? '1' : undefined}
        >
          {node.name}
        </a>
      );
      const extra = (
        <>
          {node.status && missing.has(node.status) && <span class={`chip ${node.status}`}>{t(node.status === 'missing' ? '缺档' : node.status === 'partial' ? '部分缺档' : node.status === 'planned' ? '预定' : '待确认')}</span>}
          {node.readme && <span class="badge" title={t('有说明文件')}>{t('说明')}</span>}
          <span class="n">{node.n || ''}</span>
        </>
      );
      return (
        <li>
          {node.children.length > 0 ? (
            <details open={open.has(node.key)}>
              <summary>{link}{extra}</summary>
              <Astro.self nodes={node.children} current={current} open={open} url={url} />
            </details>
          ) : (
            <>{link}{extra}</>
          )}
        </li>
      );
    })
  }
</ul>

---
import type { FileRow } from '../lib/db';
import { translateHtml } from '../lib/i18n';
import { audioSources, imageSrc, mediaSrc, videoSources, waveSrc, type Derived } from '../lib/media';
import { mimeFor } from '../lib/constants';

interface Props {
  file: Pick<FileRow, 'kind' | 'ext' | 'name' | 'source_path' | 'member_path' | 'sha256' | 'blob_key'>;
  /** Base URL of `uv run ra serve` in local development (MEDIA_DEV_BASE); empty when deployed. */
  base: string;
  /** The content's derived files (stream FLAC, AAC, WebP, MP4, waveform), when made. */
  derived?: Derived;
}

const { file, base, derived } = Astro.props;
const { t, lang } = Astro.locals;
const src = mediaSrc(file, base);
const TEXT_EXTS = new Set(['txt', 'md', 'log', 'cue', 'nfo', 'ini', 'm3u', 'm3u8', 'html', 'htm', 'css', 'js', 'bms', 'bme', 'bml', 'pms', 'json', 'xml']);
const isText = TEXT_EXTS.has(file.ext);
const player = `player-${(file.sha256 ?? Math.random().toString(16).slice(2)).slice(0, 12)}`;
const audio = file.kind === 'audio' ? audioSources(src, derived, mimeFor(file.ext)) : [];
const wave = file.kind === 'audio' ? waveSrc(derived) : null;
const video = file.kind === 'video' ? videoSources(src, derived, mimeFor(file.ext)) : null;
const picture = file.kind === 'image' ? imageSrc(src, derived, 1600) : null;
---

{
  !src ? (
    <p class="panel muted">
      {base ? (
        t('这个文件还没有解出或算出 SHA-256，暂时不能预览。')
      ) : !file.sha256 ? (
        t('这个文件没能解出（加密或损坏），没有可预览的内容。')
      ) : (
        <Fragment set:html={translateHtml(lang, '原件还没有上传到云端存储：在本机 <code>tools/ra</code> 运行 <code>uv run ra push</code>。')} />
      )}
    </p>
  ) : (
    <div class="panel">
      {audio.length > 0 && (
        <>
          <audio id={player} controls preload="none" style="width:100%">
            {audio.map((s) => <source src={s.src} type={s.type} />)}
          </audio>
          {wave && <canvas class="wave" data-wave={wave} data-audio={player} title={t('点击跳到这里')} />}
        </>
      )}
      {picture && (
        <a href={src} target="_blank" rel="noopener">
          <img src={picture} alt="" loading="lazy" style="max-width:100%;max-height:70vh" />
        </a>
      )}
      {video && (
        <video controls preload="metadata" poster={video.poster ?? undefined} style="max-width:100%;max-height:70vh">
          {video.sources.map((s) => <source src={s.src} type={s.type} />)}
        </video>
      )}
      {file.ext === 'pdf' && <iframe src={src} title="PDF" style="width:100%;height:70vh;border:0" />}
      {isText && (
        <div data-text-src={src}>
          <label class="muted">
            {t('编码')}
            <select>
              <option value="auto">{t('自动')}</option>
              <option value="utf-8">UTF-8</option>
              <option value="shift_jis">Shift-JIS</option>
              <option value="euc-jp">EUC-JP</option>
              <option value="gbk">GBK</option>
              <option value="big5">Big5</option>
              <option value="utf-16le">UTF-16 LE</option>
              <option value="utf-16be">UTF-16 BE</option>
            </select>
            <span data-detected></span>
          </label>
          <pre style="white-space:pre-wrap;max-height:60vh;overflow:auto;background:#fafaf8;padding:8px;border-radius:6px">{t('读取中…')}</pre>
        </div>
      )}
      <p>
        <a href={src} target="_blank" rel="noopener">{t('打开原件')}</a>
        {file.blob_key && <> · <a href={`${src}?download=${encodeURIComponent(file.name)}`}>{t('下载')}</a></>}
        {audio.length > 1 && <span class="muted"> · {t('播放的是推流版，下载的是原件')}</span>}
      </p>
    </div>
  )
}

<script>
  import { initPreviews } from '../scripts/previews';

  initPreviews(document);
</script>

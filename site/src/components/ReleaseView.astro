---
// The album page (作品页) of a release, drawn from lib/release-view.ts: on the left the collected editions
// (each with its own address), on the right the chosen one — covers, information, tracks that play only its
// own files, attachments — or 「版本对照」. On a phone the editions become a row of buttons above.
// The page around it (its <html>, colours, the player) is the caller's: the public site's layouts/Site.astro,
// or the admin's pages/admin/releases/[id]/preview.astro. Tracks play in components/Player.astro.
import { RELATION_MARK, RELATION_TEXT } from '../lib/editions';
import { withParams } from '../lib/format';
import { formatClock, type ReleaseView } from '../lib/release-view';

interface Props {
  view: ReleaseView;
  url: URL; // this page's address (the editions link to it with ?edition= / ?view=compare)
  eraHref?: string | null; // the era's page (the public site's works list for it)
  links?: { label: string; href: string }[]; // the release's official and shop pages
}

const { view, url, eraHref = null, links = [] } = Astro.props;
const { t } = Astro.locals;
const { release, chosen, compare } = view;
const editionHref = (id: string) => withParams(url, { edition: id, view: null });
// What the player shows of this edition's tracks (components/Player.astro reads it).
const album = chosen ? `${release.title}${chosen.name ? ` · ${chosen.name}` : ''}` : release.title;
const item = (l: NonNullable<typeof chosen>['lines'][number]) => JSON.stringify({
  file: l.file, title: l.title, sub: l.sub, album, cover: l.cover ?? chosen?.covers[0]?.src ?? null,
  href: chosen ? editionHref(chosen.id) : url.pathname, sources: l.sources, exp: view.expires,
});
---

<main class="release">
  <div class="kicker">{eraHref ? <a href={eraHref}>{release.era_name}</a> : release.era_name} · {view.formLabel}</div>
  <h1>{release.title}</h1>
  <div class="sub">{view.subline}</div>
  {links.length > 0 && (
    <div class="release-links">
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
    </div>
  )}

  {view.editions.length === 0 ? (
    <p class="muted" style="margin-top:24px">{t('这个作品还没有已收录的版本。')}</p>
  ) : (
    <div class="layout">
      <nav class="editions" aria-label={t('版本')}>
        <h2>{t('版本')}</h2>
        {view.editions.map((e) => (
          <a href={editionHref(e.id)} class:list={{ on: chosen?.id === e.id }} aria-current={chosen?.id === e.id ? 'page' : undefined}>
            {e.cover ? <img src={e.cover} alt="" loading="lazy" /> : <span class="blank"></span>}
            <span><span class="name">{e.name}</span><br /><span class="meta">{e.sub}</span></span>
          </a>
        ))}
        {view.editions.length > 1 && (
          <>
            <hr />
            <a href={withParams(url, { view: 'compare', edition: null })} class:list={['compare-link', { on: !!compare }]}>
              <span class="blank">⇄</span>
              <span><span class="name">{t('版本对照')}</span><br /><span class="meta">{t('各版本曲目异同')}</span></span>
            </a>
          </>
        )}
      </nav>

      <div class="content">
        {compare && (
          <section style="margin-top:0">
            <h2 class="sec">{t('版本对照')}</h2>
            {compare.rows.length === 0 ? <p class="muted">{t('还没有可以对照的曲目表。')}</p> : (
              <div class="compare">
                <table>
                  <thead><tr><th></th>{compare.editions.map((e) => <th><a href={editionHref(e.id)}>{view.compareNames.get(e.id) ?? e.name}</a><div class="muted">{e.catalog_no ?? ''}</div></th>)}</tr></thead>
                  <tbody>
                    {compare.rows.map(({ track, cells }) => (
                      <tr>
                        <td>{track.title}</td>
                        {cells.map((c) => (
                          <td class={c ? `r-${c.relation}` : ''} title={c ? t(RELATION_TEXT[c.relation]) : t('这一版没有')}>
                            {c ? `${c.position ?? '·'} ${RELATION_MARK[c.relation]}${c.relation === 'part' && c.share !== undefined ? ` ${Math.round(c.share * 100)}%` : ''}` : '—'}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <p class="muted" style="font-size:12px">{t('= 完全相同　≈ 同一母带　△ 重新混音或母带　◐ 部分相同　≠ 不同录音　+ 这一版新增')}</p>
          </section>
        )}

        {chosen && (
          <>
            <div class="ed-head">
              <div>
                {chosen.covers[0] ? <img class="cover" id="big-cover" src={chosen.covers[0].src} alt="" width="640" height="640" fetchpriority="high" /> : <div class="nocover">{t('无封面')}</div>}
                {chosen.covers.length > 1 && (
                  <div class="thumbs">
                    {chosen.covers.map((c, i) => <button type="button" class:list={{ on: i === 0 }} data-cover={c.src} title={t('用于 {n} 首', { n: c.n })}><img src={c.src} alt="" /></button>)}
                  </div>
                )}
              </div>
              <div>
                <div class="ed-kind">{chosen.name}</div>
                <div class="ed-title">{chosen.albumTitle}</div>
                <div class="sub">
                  {chosen.subline}
                  {chosen.status === 'partial' && <> · <span class="muted">{t('部分缺档')}</span></>}
                </div>
                {chosen.credits.length > 0 && <dl class="credits">{chosen.credits.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>}
                {chosen.description && (
                  <p class="description">
                    {chosen.descriptionOriginal && <span class="original-mark">{t('原文')}</span>}
                    {chosen.description}
                  </p>
                )}
                {chosen.note && <p class="description">{chosen.note}</p>}
                <div class="actions">
                  {chosen.lines.some((l) => l.sources) && <button type="button" class="primary" data-play-all="#tracks">{t('▶ 播放全部')}</button>}
                  {chosen.download
                    ? <a href={chosen.download}>{chosen.withTracks ? t('下载本版（带标签）') : t('下载本版')}</a>
                    : <button type="button" disabled title={t('下载将随注册功能开放')}>{t('登录后下载')}</button>}
                  {chosen.musicbrainz && <a href={chosen.musicbrainz} target="_blank" rel="noopener">MusicBrainz ↗</a>}
                  {chosen.bandcamp && <a href={chosen.bandcamp} target="_blank" rel="noopener">Bandcamp ↗</a>}
                </div>
              </div>
            </div>

            {chosen.withTracks && (
              <section>
                <h2 class="sec">{t('曲目')}</h2>
                <table id="tracks" class="tracks" data-queue>
                  <tbody>
                    {chosen.lines.map((l) => (
                      <tr data-track={l.sources ? item(l) : undefined} data-file={l.file ?? undefined}>
                        <td class="n">{chosen.multiDisc ? `${l.disc}-` : ''}{String(l.position).padStart(2, '0')}</td>
                        {chosen.differentCovers && <td class="cv">{l.cover ? <img src={l.cover} alt="" loading="lazy" /> : null}</td>}
                        <td>{l.song ? <a class="song" href={l.song}>{l.title}</a> : l.title}{l.sub && <div class="tsub">{l.sub}</div>}</td>
                        <td class="time">{l.seconds ? formatClock(l.seconds) : ''}</td>
                        <td class="play">{l.sources ? <button type="button" class="play" data-play aria-label={t('播放 {title}', { title: l.title })}><svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg><svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg></button> : null}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {!chosen.lines.some((l) => l.sources) && <p class="muted">{t('这个版本的音频还没有收录，只列出曲目。')}</p>}
              </section>
            )}

            {chosen.attachments.length > 0 && (
              <section>
                <h2 class="sec">{chosen.withTracks ? t('附件') : t('文件')}</h2>
                {chosen.attachments.map((g) => (
                  <>
                    {g.label && <div class="group">{g.label}</div>}
                    {g.videos.length > 0 && (
                      <div class="videos">
                        {g.videos.map((v) => (
                          <figure>
                            <video controls preload="none" poster={v.poster ?? undefined} playsinline>
                              {v.sources.map((s) => <source src={s.src} type={s.type} />)}
                            </video>
                            <figcaption>{v.name}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                    {g.pictures.length > 0 && (
                      <div class="gallery">
                        {g.pictures.map((p) => ('href' in p ? (
                          <a href={p.href} data-view="image">
                            <img src={p.thumb} alt="" loading="lazy" />
                            {p.caption}
                          </a>
                        ) : <span class="muted">{p.name}</span>))}
                      </div>
                    )}
                    {g.docs.length > 0 && (
                      <table class="docs">
                        <tbody>
                          {g.docs.map((d) => (
                            <tr>
                              <td>{d.name}</td>
                              <td class="muted" style="width:6em">{d.size}</td>
                              <td style="width:4em">{d.view ? <a href={d.view} data-view="text">{t('查看')}</a> : d.download ? <a href={d.download}>{t('下载')}</a> : null}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )}
                  </>
                ))}
              </section>
            )}
          </>
        )}
      </div>
    </div>
  )}
</main>
<dialog class="lightbox" id="lightbox"></dialog>

<style is:global>
  .release { max-width: 1240px; margin: 0 auto; padding: 20px 16px; }
  .release .kicker { color: var(--muted); font-size: 14px; }
  .release .kicker a { color: inherit; }
  .release h1 { margin: 2px 0 2px; font-size: 30px; line-height: 1.25; }
  .release .sub { color: var(--muted); }
  .release-links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: 14px; }
  .release .layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 28px; margin-top: 20px; align-items: start; }
  .release nav.editions { position: sticky; top: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
  .release nav.editions h2 { font-size: 13px; color: var(--muted); margin: 0 0 6px; font-weight: 500; }
  .release nav.editions a { display: grid; grid-template-columns: 44px 1fr; gap: 10px; align-items: center; padding: 6px; border-radius: 8px; color: var(--ink); text-decoration: none; }
  .release nav.editions a:hover { background: var(--now); }
  .release nav.editions a.on { background: var(--now); box-shadow: inset 3px 0 0 var(--accent); }
  .release nav.editions img, .release nav.editions .blank { width: 44px; height: 44px; object-fit: cover; border-radius: 4px; background: var(--blank); display: block; }
  .release nav.editions .name { font-size: 14px; line-height: 1.35; }
  .release nav.editions .meta { font-size: 12px; color: var(--muted); }
  .release nav.editions hr { border: 0; border-top: 1px solid var(--line); margin: 8px 0; }
  .release nav.editions .compare-link .blank { display: grid; place-items: center; color: var(--muted); background: none; }
  .release .ed-head { display: grid; grid-template-columns: minmax(200px, 360px) 1fr; gap: 28px; align-items: start; }
  .release .cover { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 8px; background: var(--blank); display: block; box-shadow: 0 6px 22px rgb(0 0 0 / 0.14); }
  .release .nocover { width: 100%; aspect-ratio: 1; border-radius: 8px; background: var(--blank); display: grid; place-items: center; color: var(--muted); }
  .release .thumbs { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .release .thumbs button { border: 2px solid transparent; padding: 0; border-radius: 6px; background: none; cursor: pointer; }
  .release .thumbs button.on { border-color: var(--accent); }
  .release .thumbs img { width: 48px; height: 48px; object-fit: cover; border-radius: 4px; display: block; }
  .release .ed-kind { color: var(--accent); font-weight: 600; }
  .release .ed-title { font-size: 26px; margin: 2px 0 6px; line-height: 1.3; }
  .release dl.credits { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; margin: 12px 0; }
  .release dl.credits dt { color: var(--muted); }
  .release dl.credits dd { margin: 0; }
  .release .description { white-space: pre-wrap; }
  .release .original-mark { display: inline-block; font-size: 11px; line-height: 1; padding: 3px 5px; margin-right: 6px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); vertical-align: 2px; }
  .release .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .release .actions a, .release .actions button { border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 6px; padding: 7px 14px; text-decoration: none; cursor: pointer; font: inherit; }
  .release .actions button:disabled { cursor: not-allowed; color: var(--muted); }
  .release .actions .primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .release section { margin-top: 30px; }
  .release h2.sec { font-size: 18px; border-bottom: 1px solid var(--line); padding-bottom: 6px; margin: 0 0 4px; }
  .release table { width: 100%; border-collapse: collapse; }
  .release td, .release th { padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: middle; text-align: left; }
  .release td.n { width: 3.2em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .release td.cv { width: 42px; } .release td.cv img { width: 36px; height: 36px; object-fit: cover; border-radius: 3px; display: block; }
  .release td.time { width: 4.5em; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
  .release td.play { width: 3.4em; text-align: right; }
  .release a.song { color: inherit; text-decoration: none; }
  .release a.song:hover { text-decoration: underline; }
  .release .tsub { color: var(--muted); font-size: 13px; }
  .release button.play { border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 50%; width: 32px; height: 32px; cursor: pointer; display: inline-grid; place-items: center; padding: 0; }
  .release button.play svg { width: 16px; height: 16px; fill: currentColor; }
  .release button.play .i-pause, .release tr.playing button.play .i-play { display: none; }
  .release tr.playing button.play .i-pause { display: block; }
  .release tr.now td { background: var(--now); }
  .release tr.now button.play { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .release .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-top: 10px; }
  .release .gallery a { display: block; color: var(--muted); font-size: 12px; text-decoration: none; overflow-wrap: anywhere; }
  .release .gallery img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 6px; background: var(--blank); display: block; margin-bottom: 4px; }
  .release .videos { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 10px; }
  .release .videos figure { margin: 0; }
  .release .videos video { width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 6px; display: block; }
  .release .videos figcaption { color: var(--muted); font-size: 12px; margin-top: 4px; overflow-wrap: anywhere; }
  .release .group { margin-top: 14px; font-size: 13px; color: var(--muted); }
  .release .docs td { font-size: 14px; overflow-wrap: anywhere; }
  .release .muted { color: var(--muted); }
  .release .compare { overflow-x: auto; }
  .release .compare td, .release .compare th { font-size: 12px; white-space: nowrap; text-align: center; }
  .release .compare td:first-child, .release .compare th:first-child { text-align: left; white-space: normal; }
  .release .r-new { background: var(--r-new); } .release .r-same, .release .r-master { background: var(--r-same); } .release .r-remix { background: var(--r-remix); } .release .r-part { background: var(--r-part); } .release .r-other { background: var(--r-other); }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.8); }
  .lightbox img { max-width: 94vw; max-height: 90vh; display: block; }
  .lightbox pre { background: var(--card); color: var(--ink); padding: 16px; max-width: 90vw; max-height: 86vh; overflow: auto; white-space: pre-wrap; margin: 0; border-radius: 8px; font-size: 13px; }
  @media (max-width: 860px) {
    .release .layout { grid-template-columns: 1fr; gap: 14px; }
    .release nav.editions { position: static; display: flex; align-items: flex-start; gap: 6px; overflow-x: auto; padding: 0; border: 0; border-radius: 0; background: none; scrollbar-width: none; }
    .release nav.editions h2, .release nav.editions hr, .release nav.editions .meta, .release nav.editions img, .release nav.editions .blank, .release nav.editions .compare-link .blank, .release nav.editions br { display: none; }
    .release nav.editions a { display: block; white-space: nowrap; border: 1px solid var(--line); border-radius: 18px; padding: 4px 12px; background: var(--card); flex: none; }
    .release nav.editions a.on { background: var(--accent); color: var(--on-accent); box-shadow: none; border-color: var(--accent); }
    .release .ed-head { grid-template-columns: 1fr; gap: 14px; }
    .release .ed-head .cover, .release .ed-head .nocover { max-width: 360px; }
    .release h1 { font-size: 24px; }
    .release td.cv { display: none; }
  }
</style>

<script>
  // Once per visit (pages may be swapped in place by the public site's router), so everything listens on
  // the document. Tracks are played by components/Player.astro.
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    // The covers of an edition whose tracks carry different ones.
    const thumb = target.closest<HTMLButtonElement>('[data-cover]');
    if (thumb) {
      const big = document.querySelector<HTMLImageElement>('#big-cover');
      if (big) big.src = thumb.dataset.cover!;
      document.querySelectorAll('[data-cover]').forEach((x) => x.classList.toggle('on', x === thumb));
      return;
    }
    // Pictures and text files open over the page.
    const a = target.closest<HTMLAnchorElement>('a[data-view]');
    const box = document.querySelector<HTMLDialogElement>('#lightbox');
    if (!a || !box) return;
    e.preventDefault();
    box.innerHTML = '';
    if (a.dataset.view === 'image') {
      const img = document.createElement('img');
      img.src = a.href;
      img.alt = '';
      box.appendChild(img);
      box.showModal();
      return;
    }
    const pre = document.createElement('pre');
    pre.textContent = '…';
    box.appendChild(pre);
    box.showModal();
    const bytes = new Uint8Array(await (await fetch(a.href)).arrayBuffer());
    let text = new TextDecoder('utf-8').decode(bytes);
    if (text.includes('\uFFFD')) {
      for (const enc of ['utf-16le', 'shift_jis']) {
        try {
          text = new TextDecoder(enc, { fatal: true }).decode(bytes);
          break;
        } catch {
          // next
        }
      }
    }
    pre.textContent = text;
  });
  document.addEventListener('click', (e) => {
    // A click outside the text, or on the picture, closes it.
    const box = (e.target as HTMLElement).closest<HTMLDialogElement>('dialog.lightbox');
    if (box && (e.target === box || (e.target as HTMLElement).tagName === 'IMG')) box.close();
  });
</script>

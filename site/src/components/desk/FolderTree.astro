---
// The folder tree of the 整理台's sidebar. Every row is a link (opens the folder), a drop target (files
// and folders dropped on it move there) and draggable; the page's script adds the rest (right-click
// menu, renaming, opening and closing, which it remembers).
import type { LocNode } from '../../lib/locations';
import FolderIcon from './FolderIcon.astro';

interface Props {
  nodes: LocNode[];
  current: string; // key of the open folder
  open: Set<string>; // keys of the folders on the way to it
  problems: Map<string, string[]>; // edition id → what to fix
  editions: Map<string, string>; // folder id → edition id
  depth?: number;
}

const { nodes, current, open, problems, editions, depth = 0 } = Astro.props;
const { t } = Astro.locals;
const statusText: Record<string, string> = { missing: '缺档', partial: '部分缺档', planned: '预定', unknown: '待确认' };
---

<ul class="ftree" role={depth === 0 ? 'tree' : 'group'}>
  {
    nodes.map((node) => {
      const issues = problems.get(editions.get(node.id) ?? '') ?? [];
      return (
        <li class:list={['fnode', { open: open.has(node.key), leaf: node.children.length === 0 }]} data-id={node.id} role="treeitem" aria-expanded={node.children.length ? (open.has(node.key) ? 'true' : 'false') : undefined}>
          <div class:list={['frow', { current: current === node.key, zero: node.n === 0 }]} data-folder={node.id} data-kind={node.kind} data-drop="folder" draggable="true" style={`--depth:${depth}`}>
            <button type="button" class:list={['twisty', { none: node.children.length === 0 }]} tabindex="-1" aria-label={t('展开或收起')} />
            <FolderIcon kind={node.extras ? 'extras' : node.kind} color={node.color} />
            <a class="fname" href={`/admin/inbox?loc=${node.key}`} data-nav>{node.name}</a>
            {node.status && statusText[node.status] && <span class={`chip ${node.status}`}>{t(statusText[node.status])}</span>}
            {issues.length > 0 && <span class="issue" title={issues.map((i) => t(i)).join(t('；'))}>!</span>}
            {node.readme && <span class="badge" title={t('有说明文件')}>{t('说明')}</span>}
            <span class="n">{node.n || ''}</span>
          </div>
          {node.children.length > 0 && <Astro.self nodes={node.children} current={current} open={open} problems={problems} editions={editions} depth={depth + 1} />}
        </li>
      );
    })
  }
</ul>

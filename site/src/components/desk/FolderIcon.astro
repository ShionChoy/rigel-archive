---
// The icon of a folder: its type (普通 / 名义 / 作品 / 版本) as the shape, its colour when one is set.
interface Props {
  kind: string;
  color?: string | null;
  size?: number;
}
const { kind, color = null, size = 16 } = Astro.props;
---

<svg class={`ficon ${kind}`} data-color={color ?? undefined} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true">
  {kind === 'era' && <path d="M3.5 1.5v13M3.5 2h9l-2.2 3.2L12.5 8.4h-9" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />}
  {kind === 'release' && (
    <>
      <circle cx="8" cy="8" r="6.6" fill="currentColor" />
      <circle cx="8" cy="8" r="1.9" fill="var(--panel, #fff)" />
    </>
  )}
  {kind === 'edition' && (
    <>
      <rect x="1.5" y="4.5" width="10" height="10" rx="1.5" fill="currentColor" />
      <path d="M4.5 2h8a1.5 1.5 0 0 1 1.5 1.5v8" fill="none" stroke="currentColor" stroke-width="1.4" />
    </>
  )}
  {kind === 'plain' && <path d="M1.2 3.6c0-.6.5-1.1 1.1-1.1h3.9l1.6 1.7h5.9c.6 0 1.1.5 1.1 1.1v7.6c0 .6-.5 1.1-1.1 1.1H2.3c-.6 0-1.1-.5-1.1-1.1z" fill="currentColor" />}
</svg>

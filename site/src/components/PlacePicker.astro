---
// The 「移动到…」 dialog: the archive's folder tree (opened folder by folder, their files shown greyed),
// the places used last above it, and a search over every folder's path. Opened by
// scripts/place-picker.ts (openPicker), which resolves with the chosen place.
import { folderKey, type Places } from '../lib/locations';

interface Props {
  places: Places;
  /** false: the page carries the folders already (the 整理台's #desk-data); the picker reads them from there. */
  options?: boolean;
}

const { places, options: embed = true } = Astro.props;
const { t } = Astro.locals;
const options = !embed ? [] : [
  { key: 'top', path: t('顶层'), kind: 'top', depth: 0 },
  ...places.options(t).map((o) => ({ key: o.key, path: o.path, name: o.name, kind: o.kind, depth: o.depth + 1, parent: o.parent ? folderKey(o.parent) : null })),
];
---

<dialog id="place-picker" class="picker">
  <form method="dialog">
    <h3 data-title>{t('移动到…')}</h3>
    <input type="search" data-search placeholder={t('搜索：作品名、编号、版本或文件夹，如「lengsel 第 2 版」')} autocomplete="off" />
    <ul class="ftree picker-tree" data-list role="tree" tabindex="-1" aria-label={t('位置')}></ul>
    <div class="picker-extra">
      <label data-new-row>{t('在所选位置下新建文件夹（可选）')} <input type="text" data-new-folder maxlength="100" /></label>
      <label data-keep-row hidden><input type="checkbox" data-keep /> <span data-keep-label></span></label>
    </div>
    <p class="picker-chosen muted" data-chosen></p>
    <div class="picker-buttons">
      <button value="cancel" type="submit">{t('取消')}</button>
      <button class="primary" value="ok" type="submit" data-ok disabled>{t('移动到这里')}</button>
    </div>
  </form>
  {embed && <script type="application/json" data-options set:html={JSON.stringify(options).replace(/</g, '\\u003c')} />}
</dialog>

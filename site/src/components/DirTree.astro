---
// The original folders (按来源浏览): each with how many files it still has to organize. Only the way to the
// open folder is drawn open; a folder with subfolders that is closed is sent without them and fetches them
// when opened (data-lazy; /admin/desk/source?under=<path>), so the tree of ten thousand folders stays small.
import { ARCHIVE_NAME } from '../lib/constants';
import { withParams } from '../lib/format';

export interface DirNode {
  name: string;
  path: string;
  n: number;
  left?: number; // files still to organize, when shown
  children: DirNode[];
}

interface Props {
  nodes: DirNode[];
  current: string;
  url: URL;
  /** Other query parameters every link sets (e.g. view=all). */
  params?: Record<string, string | null>;
}

const { nodes, current, url, params = {} } = Astro.props;
const isOpen = (node: DirNode) => current === node.path || current.startsWith(`${node.path}/`);
// An archive node lists its unpacked members (ra extract gives them the archive's path as folder).
const mark = (node: DirNode) => (ARCHIVE_NAME.test(node.name) ? 'archive' : undefined);
const href = (node: DirNode) => withParams(url, { ...params, dir: node.path, page: null });
const count = (node: DirNode) => (node.left === undefined ? String(node.n) : node.left ? `${node.left} / ${node.n}` : `✓ ${node.n}`);
---

<ul>
  {
    nodes.map((node) => (
      <li>
        {node.children.length > 0 ? (
          <details open={isOpen(node)} data-lazy={isOpen(node) ? undefined : node.path}>
            <summary>
              <a class:list={[mark(node), { current: current === node.path, done: node.left === 0 }]} href={href(node)} data-dir={node.path} data-nav>
                {node.name}
              </a>
              <span class="n">{count(node)}</span>
            </summary>
            {isOpen(node) && <Astro.self nodes={node.children} current={current} url={url} params={params} />}
          </details>
        ) : (
          <>
            <a class:list={[mark(node), { current: current === node.path, done: node.left === 0 }]} href={href(node)} data-dir={node.path} data-nav>
              {node.name}
            </a>
            <span class="n">{count(node)}</span>
          </>
        )}
      </li>
    ))
  }
</ul>

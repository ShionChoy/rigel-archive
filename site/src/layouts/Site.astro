---
// The public site's page (设计文档「公开站方案」): header with the site's name and «Unofficial Fan Archive»,
// the three languages and the theme; the page; the footer with the unofficial notice; and the player, kept
// playing while visitors move between pages (Astro's ClientRouter swaps pages in place, transition:persist
// keeps the player).
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import Player from '../components/Player.astro';
import { HTML_LANG, LANG_NAMES, SITE_LANGS } from '../lib/i18n';
import { inLang, pagesFor } from '../lib/public/paths';
import { SITE } from '../lib/site';

interface Props {
  title: string | null; // null: the home page (the site's name only)
  description?: string | null;
  image?: string | null; // for link previews (a cover)
  section?: 'home' | 'works' | 'about' | null; // highlighted in the navigation
}

const { title, description = null, image = null, section = null } = Astro.props;
const { t, lang } = Astro.locals;
const pages = pagesFor(lang);
const url = Astro.url;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const summary = description ?? t('Rigël Theatre 全作品的非官方档案站：所有人都可以在线收听无损全曲。');
const canonical = new URL(url.pathname + url.search, url.origin).href;
const nav = [
  { id: 'works', href: pages.works(), label: t('作品') },
  { id: 'about', href: pages.about, label: t('关于') },
] as const;
const SHORT: Record<string, string> = { zh: '中', ja: '日', en: 'EN' };
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    {SITE.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {SITE_LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(inLang(url, l), url.origin).href} />)}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, url.origin).href} />}
    <meta name="theme-color" content="#0a0e1b" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230a0e1b'/%3E%3Cpath d='M16 5l8 11-8 11-8-11z' fill='%23e2c17b'/%3E%3C/svg%3E" />
    <script is:inline>
      // The visitor's theme before the page is drawn (dark unless they chose light).
      try {
        if (localStorage.getItem('rigel.site.theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={pages.home}>
          <span class="brand-mark" aria-hidden="true">◆</span>
          <span class="brand-name">{SITE.name}</span>
          <span class="brand-tag">{SITE.tagline}</span>
        </a>
        <nav class="site-nav" aria-label={t('栏目')}>
          {nav.map((n) => <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="site-tools">
          <div class="langs" role="group" aria-label={t('语言')}>
            {SITE_LANGS.map((l) => (
              <a href={inLang(url, l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]} data-lang={l}>{SHORT[l]}</a>
            ))}
          </div>
          <button type="button" class="theme-toggle" aria-label={t('切换深色 / 浅色')} title={t('切换深色 / 浅色')}>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="notice"><span class="diamond"></span>{t('本站为粉丝运营的非官方档案站，尚未获 Rigël Theatre 官方认可。')}</div>
        <div class="links">
          <a href={SITE.official} target="_blank" rel="noopener">{t('Rigël Theatre 官方网站')} ↗</a>
          <a href={pages.about}>{t('关于本站')}</a>
        </div>
        <div>{t('各作品的著作权归 Rigël Theatre 及各权利人所有。')}</div>
      </div>
    </footer>

    <Player />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

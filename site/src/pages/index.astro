---
// `/`: the public site in the visitor's language — the one they used last (cookie site_lang, set by
// scripts/site.ts), else the first of their browser's languages the site has, else English.
import { isSiteLang, siteLangFromHeader } from '../lib/i18n';

const saved = Astro.cookies.get('site_lang')?.value;
const lang = isSiteLang(saved) ? saved : siteLangFromHeader(Astro.request.headers.get('accept-language'));
return new Response(null, {
  status: 302,
  headers: { location: `/${lang}/`, vary: 'accept-language, cookie', 'cache-control': 'private, no-cache' },
});
---

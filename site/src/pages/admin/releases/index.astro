---
import Admin from '../../../layouts/Admin.astro';
import { editionCovers } from '../../../lib/covers';
import { db, type ReleaseRow } from '../../../lib/db';
import { EDITION_STATUS_LABELS, sortEditions } from '../../../lib/editions';
import { loadForms } from '../../../lib/forms';
import { withParams } from '../../../lib/format';
import { loadEras } from '../../../lib/releases';
import { loadTypes } from '../../../lib/types';

const url = Astro.url;
const { t } = Astro.locals;
const era = url.searchParams.get('era') ?? '';
const [eras, forms] = await Promise.all([loadEras(), loadForms()]);
const form = forms.has(url.searchParams.get('form')) ? url.searchParams.get('form')! : '';

type Row = Pick<ReleaseRow, 'id' | 'catalog_no' | 'era_id' | 'form' | 'series' | 'title' | 'release_date' | 'state'> & {
  editions: string;
  files: number;
};
type Ed = { id: string; slot: string; name: string; status: keyof typeof EDITION_STATUS_LABELS; sort: number; release_date: string | null };

const stmt = db().prepare(
  `SELECT r.id, r.catalog_no, r.era_id, r.form, r.series, r.title, r.release_date, r.state,
          (SELECT json_group_array(json_object('id', id, 'slot', slot, 'name', name, 'status', status, 'sort', sort, 'release_date', release_date))
             FROM editions WHERE release_id = r.id) AS editions,
          (SELECT count(*) FROM files WHERE release_id = r.id) AS files
   FROM releases r JOIN eras e ON e.id = r.era_id
   WHERE (?1 = '' OR r.era_id = ?1) AND (?2 = '' OR r.form = ?2)
   ORDER BY e.sort, r.release_date DESC NULLS LAST, r.catalog_no, r.title`,
);
const [{ results }, types, counts] = await Promise.all([
  stmt.bind(era, form).all<Row>(),
  loadTypes(),
  db().prepare('SELECT form, count(*) AS n FROM releases WHERE ?1 = \'\' OR era_id = ?1 GROUP BY form').bind(era).all<{ form: string | null; n: number }>(),
]);
const formCount = new Map(counts.results.map((c) => [c.form ?? '', c.n]));
// A release's picture: the first cover of its first collected edition (in the types' order).
const firstCollected = new Map(results.map((r) => [r.id, sortEditions(JSON.parse(r.editions ?? '[]') as Ed[], types).find((e) => e.status === 'collected' || e.status === 'partial')?.id]));
const covers = await editionCovers([...firstCollected.values()].filter((x): x is string => !!x), { size: 240 });
---

<Admin title={t('作品')}>
  <div class="filters">
    <a class:list={['button', { primary: !era }]} href={withParams(url, { era: null })}>{t('全部')}</a>
    {eras.map((e) => <a class:list={['button', { primary: era === e.id }]} href={withParams(url, { era: e.id })}>{e.name}</a>)}
    <form method="get" class="inline form-filter">
      {era && <input type="hidden" name="era" value={era} />}
      <label>{t('形式')}
        <select name="form" onchange="this.form.submit()">
          <option value="">{t('全部形式')}</option>
          {forms.list.map((f) => <option value={f.id} selected={f.id === form}>{forms.label(f.id, t)}（{formCount.get(f.id) ?? 0}）</option>)}
        </select>
      </label>
      <noscript><button type="submit">{t('筛选')}</button></noscript>
    </form>
    <a class="button" href="/admin/types" style="margin-left:auto">{t('形式与版本类型')}</a>
    <a class="button primary" href="/admin/releases/new">{t('新建作品')}</a>
  </div>

  <table class="grid">
    <thead>
      <tr>
        <th></th>
        <th>{t('编号')}</th>
        <th>{t('作品')}</th>
        <th>{t('发行')}</th>
        <th>{t('形式')}</th>
        <th>{t('版本')}</th>
        <th class="num">{t('文件')}</th>
      </tr>
    </thead>
    <tbody>
      {
        results.map((r) => {
          const editions = sortEditions(JSON.parse(r.editions ?? '[]') as Ed[], types);
          return (
            <tr>
              <td class="rel-cover">{(() => {
                const c = covers.get(firstCollected.get(r.id) ?? '')?.[0];
                return c ? <img src={c.src} alt="" loading="lazy" /> : <span class="ed-nocover"></span>;
              })()}</td>
              <td class="mono">{r.catalog_no ?? '—'}</td>
              <td>
                <a href={`/admin/releases/${r.id}`}>{r.title}</a>
                {r.state === 'draft' && <span class="chip">{t('草稿')}</span>}
                {r.series && <div class="muted">{r.series}</div>}
              </td>
              <td class="mono">{r.release_date ?? '—'}</td>
              <td><a href={withParams(url, { form: r.form })}>{forms.label(r.form, t)}</a></td>
              <td>
                <div class="slots">
                  {editions.map((e) => (
                    <a class={`chip ${e.status}`} href={`/admin/editions/${e.id}`} title={t(EDITION_STATUS_LABELS[e.status])}>{types.editionLabel(e, t)}</a>
                  ))}
                  {editions.length === 0 && <span class="muted">—</span>}
                </div>
              </td>
              <td class="num"><a href={`/admin/inbox?state=all&release=${r.id}`}>{r.files}</a></td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</Admin>

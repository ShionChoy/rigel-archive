---
import Admin from '../../../layouts/Admin.astro';
import ReleaseFields from '../../../components/ReleaseFields.astro';
import { RELEASE_KIND_LABELS } from '../../../lib/constants';
import { batchSince } from '../../../lib/changes';
import { editionCovers } from '../../../lib/covers';
import { db, type ReleaseRow } from '../../../lib/db';
import {
  EDITION_STATUSES, EDITION_STATUS_LABELS, RELATION_MARK, RELATION_TEXT, comparison, createEdition, loadEditions, mergeTracks, parseIds,
} from '../../../lib/editions';
import { formatDuration, percent, withParams } from '../../../lib/format';
import { N_, UserError, errorText, translateHtml } from '../../../lib/i18n';
import { Places } from '../../../lib/locations';
import { LANGS, saveInfo, saveTranslations } from '../../../lib/releases';
import { formatMs, loadTracks, sameTitleSongs, saveTracks } from '../../../lib/tracks';
import { NEW_TYPE } from '../../../lib/types';

const { id } = Astro.params;
const { t, lang } = Astro.locals;
const database = db();
const release = await database.prepare('SELECT * FROM releases WHERE id = ?').bind(id).first<ReleaseRow>();
if (!release) return new Response(t('找不到作品'), { status: 404 });

if (Astro.request.method === 'POST') {
  const started = new Date().toISOString();
  const form = await Astro.request.formData();
  const actor = Astro.locals.admin!.email;
  const saved = (n: number) => (n ? t('已保存（{n} 处改动）', { n }) : t('没有改动'));
  try {
    let msg: string;
    switch (form.get('section')) {
      case 'info':
        msg = saved(await saveInfo(actor, release, form));
        break;
      case 'i18n':
        msg = saved(await saveTranslations(actor, release, form));
        break;
      case 'tracks':
        msg = saved(await saveTracks(actor, release, await loadTracks(release.id), form));
        break;
      case 'edition_new': {
        const editionId = await createEdition(actor, release, form);
        return Astro.redirect(`/admin/editions/${editionId}?msg=${encodeURIComponent(t('已新建版本'))}`, 303);
      }
      case 'merge':
        msg = saved(await mergeTracks(actor, release, String(form.get('keep') ?? ''), String(form.get('drop') ?? '')));
        break;
      default:
        throw new UserError('未知的表单');
    }
    const undo = await batchSince(database, actor, started);
    return Astro.redirect(withParams(Astro.url, { msg, err: null, undo }) + (form.get('anchor') ? `#${form.get('anchor')}` : ''), 303);
  } catch (e) {
    return Astro.redirect(withParams(Astro.url, { err: errorText(e, t), msg: null }), 303);
  }
}

const [editions, tracks, translations, matrix, places, counts] = await Promise.all([
  loadEditions(release.id),
  loadTracks(release.id),
  database
    .prepare("SELECT field, lang, value FROM translations WHERE entity = 'release' AND entity_id = ?")
    .bind(release.id)
    .all<{ field: string; lang: string; value: string }>(),
  comparison(release.id),
  Places.load(),
  database
    .prepare(
      `SELECT edition_id, folder_id, count(*) AS n, sum(kind = 'audio') AS audio FROM files
       WHERE release_id = ? AND sealed_in IS NULL AND state != 'ignored' GROUP BY edition_id, folder_id`,
    )
    .bind(release.id)
    .all<{ edition_id: string | null; folder_id: string | null; n: number; audio: number }>(),
]);
const covers = await editionCovers(editions.map((e) => e.id), { read: true, size: 240 });
const { results: etCounts } = await database
  .prepare('SELECT et.edition_id, count(*) AS n FROM edition_tracks et JOIN editions e ON e.id = et.edition_id WHERE e.release_id = ? GROUP BY et.edition_id')
  .bind(release.id)
  .all<{ edition_id: string; n: number }>();
const trackCount = new Map(etCounts.map((r) => [r.edition_id, r.n]));
const filesIn = (editionId: string) => counts.results.filter((c) => c.edition_id === editionId).reduce((n, c) => n + c.n, 0);
// Files of the release that are not in one of its editions (in the release's folder or its plain folders).
const loose = counts.results.filter((c) => !c.edition_id).reduce((n, c) => n + c.n, 0);
const releaseFolders = places.childFolders(`rel:${release.id}`).filter((f) => f.type === 'plain');
const candidates = await sameTitleSongs(tracks);
const songTitles = new Map<string, string>();
if (tracks.length) {
  const { results } = await database
    .prepare('SELECT s.id, s.title, (SELECT count(*) FROM tracks t WHERE t.song_id = s.id) AS n FROM songs s WHERE s.id IN (SELECT song_id FROM tracks WHERE release_id = ?)')
    .bind(release.id)
    .all<{ id: string; title: string; n: number }>();
  for (const s of results) songTitles.set(s.id, s.n > 1 ? t('{title}（{n} 个版本）', { title: s.title, n: s.n }) : s.title);
}
const tr = (field: string, code: string) => translations.results.find((x) => x.field === field && x.lang === code)?.value ?? '';
const LANG_NAMES: Record<string, string> = { zh: N_('中文'), ja: N_('日文'), en: N_('英文') };
const editionLabel = (e: { slot: string; name: string }) => places.editionLabel(e, t);
const types = places.types;
const hasMatrix = matrix.editions.length > 1 && matrix.rows.length > 0;
const cellText = (c: NonNullable<(typeof matrix.rows)[number]['cells'][number]>) => {
  const mark = RELATION_MARK[c.relation];
  const time = c.relation === 'ref' || c.relation === 'new' ? formatDuration(c.file?.length ?? c.file?.duration) : '';
  const share = c.relation === 'part' && c.share !== undefined ? percent(c.share) : '';
  return [c.position ?? '·', mark, share, time].filter(Boolean).join(' ');
};
---

<Admin title={release.catalog_no ? `${release.catalog_no} ${release.title}` : release.title}>
  <p class="muted">
    {t(RELEASE_KIND_LABELS[release.kind])} · {release.release_date ?? t('日期未知')} ·
    <a href={`/admin/releases/${release.id}/preview`}>{t('预览公开页')}</a> ·
    <a href={`/admin/history?release=${release.id}`}>{t('这个作品的修改记录')}</a> ·
    <a href={`/admin/inbox?loc=rel:${release.id}`}>{t('在整理台打开这个作品的文件夹')}</a>
  </p>

  <h2 id="editions">{t('版本')}</h2>
  <div class="panel">
    <table class="grid editions-table">
      <thead><tr><th></th><th>{t('类型 · 名称')}</th><th>{t('编号')}</th><th>{t('发行日')}</th><th>{t('状态')}</th><th class="num">{t('曲目')}</th><th class="num">{t('文件')}</th><th></th></tr></thead>
      <tbody>
        {editions.map((e) => {
          const ids = parseIds(e.external_ids);
          const cover = covers.get(e.id) ?? [];
          return (
            <tr>
              <td class="ed-cover">
                {cover.length ? (
                  <a href={`/admin/editions/${e.id}`} class="ed-thumbs" title={cover.length > 1 ? t('各曲目的封面不同（{n} 种）', { n: cover.length }) : undefined}>
                    {cover.slice(0, 3).map((c) => <img src={c.src} alt="" loading="lazy" />)}
                  </a>
                ) : <span class="ed-nocover" title={t('没有封面')}></span>}
              </td>
              <td>
                <a href={`/admin/editions/${e.id}`}>{editionLabel(e)}</a>
                {e.is_default ? <span class="chip collected" title={t('公开页默认显示这个版本')}>{t('默认')}</span> : null}
                {e.album_title && <div class="muted">{e.album_title}</div>}
              </td>
              <td>{e.catalog_no ?? ''}</td>
              <td>{e.release_date ?? ''}</td>
              <td><span class={`chip ${e.status}`}>{t(EDITION_STATUS_LABELS[e.status])}</span></td>
              <td class="num">{trackCount.get(e.id) ?? 0}{e.track_count && e.track_count !== (trackCount.get(e.id) ?? 0) ? <span class="muted"> / {e.track_count}</span> : null}</td>
              <td class="num"><a href={`/admin/inbox?loc=ed:${e.id}&sub=1`}>{filesIn(e.id)}</a></td>
              <td>{ids.musicbrainz_release && <a href={`https://musicbrainz.org/release/${ids.musicbrainz_release}`} target="_blank" rel="noopener" title="MusicBrainz">MB</a>}</td>
            </tr>
          );
        })}
        {editions.length === 0 && <tr><td colspan="8" class="muted">{t('还没有版本。在下面新建（如「实体 CD · 初版」「官方数字版 · Bandcamp」「图片 · 扫图集」），或从 MusicBrainz 导入；把文件按建议归档时也会自动建好。')}</td></tr>}
        {(loose > 0 || releaseFolders.length > 0) && (
          <tr>
            <td></td>
            <td colspan="5" class="muted">
              {t('相关资料（不属于某个版本）')}
              {releaseFolders.map((f) => <> · <a href={`/admin/inbox?loc=fd:${f.id}`}>{f.name}</a></>)}
            </td>
            <td class="num"><a href={`/admin/inbox?loc=rel:${release.id}&sub=1`}>{loose}</a></td>
            <td></td>
          </tr>
        )}
      </tbody>
    </table>
    <form method="post" class="inline-form new-edition">
      <input type="hidden" name="section" value="edition_new" />
      <select name="slot" aria-label={t('类型')} data-type-select>
        {types.options(t).map((o) => <option value={o.id}>{o.label}</option>)}
        <option value={NEW_TYPE}>{t('＋ 新类型…')}</option>
      </select>
      <input type="text" name="new_type" placeholder={t('新类型名称')} maxlength="40" hidden data-new-type />
      <input type="text" name="name" placeholder={t('名称，如「初版」「扫图集」「Bandcamp 24bit」')} maxlength="100" />
      <input type="text" name="catalog_no" placeholder={t('编号')} size="12" />
      <input type="text" name="release_date" placeholder={t('发行日')} size="11" />
      <select name="status" aria-label={t('状态')}>{EDITION_STATUSES.map((s) => <option value={s}>{t(EDITION_STATUS_LABELS[s])}</option>)}</select>
      <button type="submit" class="primary">{t('＋ 新建版本')}</button>
      <a class="button" href={`/admin/releases/${release.id}/musicbrainz`}>{t('从 MusicBrainz 导入版本…')}</a>
    </form>
    <p class="muted">
      {t('版本的数量和名称不限，也可以没有曲目（如只放扫图的「图片」版本）。每个版本自带一个「附件」文件夹，放 LOG、CUE、扫图等。知道存在、还没收到的版本也可以建，状态选「缺档」：它只出现在后台和缺档看板。')}
      <a href="/admin/types">{t('管理版本类型 ›')}</a>
    </p>
  </div>

  {
    hasMatrix && (
      <>
        <h2 id="compare">{t('版本对照')}</h2>
        <div class="panel">
          <div class="wide-table">
            <table class="grid compare">
              <thead>
                <tr>
                  <th>{t('曲目条目')}</th>
                  {matrix.editions.map((e) => (
                    <th>
                      <a href={`/admin/editions/${e.id}`}>{editionLabel(e)}</a>
                      <div class="muted">{[e.catalog_no, e.release_date, trackCount.get(e.id) ? t('{n} 曲', { n: trackCount.get(e.id)! }) : null].filter(Boolean).join(' · ')}</div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {matrix.rows.map(({ track, cells }) => (
                  <tr>
                    <td>{track.title}{track.version_label && <span class="muted"> ({track.version_label})</span>}</td>
                    {cells.map((c) => (
                      <td class:list={['cell', c ? `r-${c.relation}` : 'r-none']} title={c ? `${t(RELATION_TEXT[c.relation])}${c.score ? ` · ${t('一致度 {s}', { s: c.score.toFixed(2) })}` : ''}${c.file ? ` · ${c.file.name}` : ''}` : t('这一版没有')}>
                        {c ? (c.file ? <a href={`/admin/files/${c.file.id}`}>{cellText(c)}</a> : cellText(c)) : '—'}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="muted legend" set:html={translateHtml(lang, '<b>=</b> 解码后完全相同　<b>≈</b> 同一母带（格式、采样率或编码不同）　<b>△</b> 同一编曲，重新混音或母带　<b>◐ 47%</b> 只有一部分相同　<b>≠</b> 听不出相同（多为重录）　<b>+</b> 这一版新增　<b>—</b> 这一版没有。与每行最早有文件的版本比较，依据 PCM MD5 与声学指纹。')} />
          {matrix.merges.length > 0 && (
            <div class="merges">
              <b>{t('可能是同一录音的不同条目')}</b>
              {matrix.merges.map((m) => (
                <form method="post" class="inline-form">
                  <input type="hidden" name="section" value="merge" />
                  <input type="hidden" name="anchor" value="compare" />
                  <input type="hidden" name="keep" value={m.a.id} />
                  <input type="hidden" name="drop" value={m.b.id} />
                  <span>{t('「{a}」与「{b}」（一致度 {s}）', { a: m.a.title, b: m.b.title, s: m.score.toFixed(2) })}</span>
                  <button type="submit" title={t('合并后两个版本都指向同一个曲目条目，各版保留自己的曲名')}>{t('把「{b}」并入「{a}」', { a: m.a.title, b: m.b.title })}</button>
                </form>
              ))}
            </div>
          )}
        </div>
      </>
    )
  }

  <h2 id="tracks">{t('曲目条目')}</h2>
  <form method="post" class="panel">
    <input type="hidden" name="section" value="tracks" />
    <input type="hidden" name="anchor" value="tracks" />
    <p class="muted" set:html={translateHtml(lang, '这个作品各版本出现过的每一首（取并集）。各版的曲目顺序、曲名差异和标签在版本页编辑；这里改条目本身的标题、版本说明和所属乐曲。同一首曲在别的作品里的版本在<a href="/admin/songs">乐曲</a>页合并。')} />
    <table class="grid track-table" id="track-table">
      <thead>
        <tr><th></th><th>{t('碟')}</th><th class="num">{t('序号')}</th><th>{t('标题')}</th><th>{t('版本说明')}</th><th>{t('时长')}</th><th>{t('乐曲')}</th><th>{t('备注')}</th><th>{t('删除')}</th></tr>
      </thead>
      <tbody>
        {
          tracks.map((x) => (
            <tr draggable="true">
              <td class="handle" title={t('拖动排序')}>⠿<input type="hidden" name="track_id" value={x.id} /></td>
              <td><input type="number" name="disc" value={x.disc} min="1" max="99" style="width:3.5em" /></td>
              <td class="num pos">{x.position}</td>
              <td><input type="text" name="title" value={x.title} required style="width:100%" /></td>
              <td><input type="text" name="version_label" value={x.version_label ?? ''} size="10" placeholder="Short ver. …" /></td>
              <td><input type="text" name="duration" value={formatMs(x.duration_ms)} size="5" placeholder="4:32" /></td>
              <td>
                <select name="song">
                  <option value="">{x.song_id ? songTitles.get(x.song_id) ?? x.song_id : t('（无）')}</option>
                  {(candidates.get(x.id) ?? []).map((s) => <option value={s.id}>{t('改为同名乐曲：{title}（{n} 个版本）', { title: s.title, n: s.n })}</option>)}
                  <option value="new">{t('拆成独立的新乐曲')}</option>
                </select>
                {x.song_id && <a href={`/admin/songs/${x.song_id}`} title={t('乐曲页')}>↗</a>}
              </td>
              <td><input type="text" name="track_note" value={x.note ?? ''} size="10" /></td>
              <td><input type="checkbox" name="remove" value={x.id} aria-label={t('删除这一行')} /></td>
            </tr>
          ))
        }
        {tracks.length === 0 && <tr><td colspan="9" class="muted">{t('还没有曲目条目：把音频放进版本后，在版本页「从音频文件生成」，或从 MusicBrainz 导入。')}</td></tr>}
      </tbody>
    </table>
    <template id="track-row">
      <tr draggable="true">
        <td class="handle" title={t('拖动排序')}>⠿<input type="hidden" name="track_id" value="new" /></td>
        <td><input type="number" name="disc" value="1" min="1" max="99" style="width:3.5em" /></td>
        <td class="num pos"></td>
        <td><input type="text" name="title" style="width:100%" placeholder={t('新曲目标题')} /></td>
        <td><input type="text" name="version_label" size="10" /></td>
        <td><input type="text" name="duration" size="5" placeholder="4:32" /></td>
        <td><select name="song"><option value="new">{t('新建乐曲')}</option></select></td>
        <td><input type="text" name="track_note" size="10" /></td>
        <td></td>
      </tr>
    </template>
    <p>
      <button type="button" id="add-track">{t('添加一行')}</button>
      <button class="primary" type="submit">{t('保存曲目条目')}</button>
    </p>
  </form>

  <h2>{t('基本信息')}</h2>
  <form method="post" class="panel">
    <input type="hidden" name="section" value="info" />
    <ReleaseFields release={release} />
    <p><button class="primary" type="submit">{t('保存基本信息')}</button></p>
  </form>

  <h2>{t('译名与介绍')}</h2>
  <form method="post" class="panel">
    <input type="hidden" name="section" value="i18n" />
    <p class="muted">{t('原文标题：{title}。留空时页面显示原文；中文译名由管理组审定。介绍的原文在「基本信息」里。', { title: release.title })}</p>
    <div class="lang-grid">
      {
        LANGS.map((code) => (
          <div>
            <b>{t(LANG_NAMES[code])}</b>
            <label>{t('标题')}<input type="text" name={`title_${code}`} value={tr('title', code)} placeholder={code === 'ja' ? t('原文不是日文时填写') : ''} /></label>
            <label>{t('介绍')}<textarea name={`description_${code}`} rows="6">{tr('description', code)}</textarea></label>
          </div>
        ))
      }
    </div>
    <p><button class="primary" type="submit">{t('保存译名与介绍')}</button></p>
  </form>
</Admin>

<script>
  // 「＋ 新类型…」 asks for the new type's name.
  for (const el of Array.from(document.querySelectorAll('[data-type-select]'))) {
    const select = el as unknown as HTMLSelectElement;
    const input = select.form?.querySelector('[data-new-type]') as unknown as HTMLInputElement | null;
    const sync = () => {
      if (!input) return;
      input.hidden = select.value !== '__new__';
      input.required = !input.hidden;
      if (!input.hidden) input.focus();
    };
    select.addEventListener('change', sync);
  }
  const table = document.querySelector<HTMLTableElement>('#track-table');
  const body = table?.tBodies[0];
  const renumber = () => {
    const counters = new Map<string, number>();
    for (const row of Array.from(body?.rows ?? [])) {
      const discInput = row.querySelector('input[name="disc"]') as HTMLInputElement | null;
      if (!discInput) continue;
      const disc = discInput.value || '1';
      const removed = (row.querySelector('input[name="remove"]') as HTMLInputElement | null)?.checked;
      row.classList.toggle('removed', Boolean(removed));
      const cell = row.querySelector('.pos') as HTMLElement;
      if (removed) {
        cell.textContent = '—';
        continue;
      }
      const n = (counters.get(disc) ?? 0) + 1;
      counters.set(disc, n);
      cell.textContent = String(n);
    }
  };
  let dragged: HTMLTableRowElement | null = null;
  body?.addEventListener('dragstart', (e) => {
    dragged = (e.target as HTMLElement).closest('tr');
    dragged?.classList.add('dragging');
  });
  body?.addEventListener('dragend', () => {
    dragged?.classList.remove('dragging');
    dragged = null;
    renumber();
  });
  body?.addEventListener('dragover', (e) => {
    e.preventDefault();
    const over = (e.target as HTMLElement).closest('tr');
    if (!dragged || !over || over === dragged) return;
    const rect = over.getBoundingClientRect();
    body.insertBefore(dragged, e.clientY > rect.top + rect.height / 2 ? over.nextSibling : over);
  });
  body?.addEventListener('change', renumber);
  document.querySelector('#add-track')?.addEventListener('click', () => {
    const template = document.querySelector<HTMLTemplateElement>('#track-row');
    if (!template || !body) return;
    body.appendChild(template.content.cloneNode(true));
    renumber();
    (body.rows[body.rows.length - 1].querySelector('input[name="title"]') as HTMLInputElement).focus();
  });
</script>

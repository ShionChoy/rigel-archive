---
// 预览公开页: the public album page as it will look (components/ReleaseView.astro, data from
// lib/release-view.ts, under the same public rules), with a bar at the top back to the admin. It works for
// drafts too, reads files through the admin's addresses and offers the admin's downloads.
import { env } from 'cloudflare:workers';
import Player from '../../../../components/Player.astro';
import ReleaseView from '../../../../components/ReleaseView.astro';
import { db } from '../../../../lib/db';
import { HTML_LANG } from '../../../../lib/i18n';
import { adminUrls } from '../../../../lib/media';
import { loadReleaseView } from '../../../../lib/release-view';
import { siteLangOf } from '../../../../lib/public/paths';

const { id } = Astro.params;
const { t, lang } = Astro.locals;
const view = await loadReleaseView(db(), env.MEDIA, {
  releaseId: id ?? '',
  editionId: Astro.url.searchParams.get('edition'),
  compare: Astro.url.searchParams.get('view') === 'compare',
  t, lang,
  urls: adminUrls(env.MEDIA_DEV_BASE ?? ''),
  links: {
    song: (songId) => `/admin/songs/${songId}`,
    editionDownload: (editionId) => `/admin/editions/${editionId}/zip`,
    fileDownload: (f) => (f.blob_key ? `/admin/media/${f.blob_key}?download=${encodeURIComponent(f.name)}` : null),
  },
});
if (!view) return new Response(t('找不到作品'), { status: 404 });
const { release, chosen } = view;
const publicHref = release.state === 'published' ? `/${siteLangOf(lang)}/works/${release.id}/${chosen ? `?edition=${chosen.id}` : ''}` : null;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t('预览')} · {release.title}{chosen ? ` · ${chosen.name}` : ''}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('rigel.theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <style is:global>
      :root { --ink: #1d2230; --muted: #6b7079; --line: #e3e3de; --accent: #3c5aa8; --on-accent: #fff; --bg: #f7f6f2; --card: #fff; --bar: #2b3040; --bar-link: #cdd6ff; --blank: #ddd; --now: #eef2ff;
        --r-new: #e8eefa; --r-same: #e3f3ea; --r-remix: #f3f7e6; --r-part: #fbf0d9; --r-other: #fbe6e4; color-scheme: light; }
      :root[data-theme='dark'] { --ink: #e3e5e9; --muted: #9ba1ac; --line: #30353e; --accent: #86aaf5; --on-accent: #0e1422; --bg: #121418; --card: #1b1e24; --bar: #0e1013; --bar-link: #a9bff7; --blank: #2a2e35; --now: #233254;
        --r-new: #233254; --r-same: #1b3628; --r-remix: #2b3320; --r-part: #3b3019; --r-other: #44231f; color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) { --ink: #e3e5e9; --muted: #9ba1ac; --line: #30353e; --accent: #86aaf5; --on-accent: #0e1422; --bg: #121418; --card: #1b1e24; --bar: #0e1013; --bar-link: #a9bff7; --blank: #2a2e35; --now: #233254;
          --r-new: #233254; --r-same: #1b3628; --r-remix: #2b3320; --r-part: #3b3019; --r-other: #44231f; color-scheme: dark; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; font: 15px/1.6 system-ui, -apple-system, 'Noto Sans SC', 'Noto Sans JP', sans-serif; color: var(--ink); background: var(--bg); padding-bottom: 96px; }
      a { color: var(--accent); }
      .bar { background: var(--bar); color: #fff; padding: 8px 16px; font-size: 13px; }
      .bar a { color: var(--bar-link); }
      .bar .warn { color: #ffd479; }
    </style>
  </head>
  <body>
    <div class="bar">
      {t('后台预览：公开站的作品页会是这个样子。只列出已收录的版本（缺档、待确认的不显示），每个版本只播放自己的文件。')}
      <a href={`/admin/releases/${release.id}`}>{t('← 回到作品编辑')}</a>
      {chosen && <> · <a href={`/admin/editions/${chosen.id}`}>{t('编辑这个版本')}</a></>}
      {publicHref ? <> · <a href={publicHref}>{t('在公开站打开')}</a></> : ` · ${t('本作品还是草稿，不会公开')}`}
      {view.unsettled > 0 && chosen && <> · <a class="warn" href={`/admin/editions/${chosen.id}#public`}>{t('这个版本有 {n} 个文件权属未定，公开站不显示 › 设定权属', { n: view.unsettled })}</a></>}
    </div>
    <ReleaseView view={view} url={Astro.url} />
    <Player />
  </body>
</html>

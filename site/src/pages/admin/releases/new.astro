---
import Admin from '../../../layouts/Admin.astro';
import ReleaseFields from '../../../components/ReleaseFields.astro';
import { createRelease } from '../../../lib/releases';
import { withParams } from '../../../lib/format';
import { errorText } from '../../../lib/i18n';

const { t } = Astro.locals;
if (Astro.request.method === 'POST') {
  try {
    const id = await createRelease(Astro.locals.admin!.email, await Astro.request.formData());
    return Astro.redirect(`/admin/releases/${id}?msg=${encodeURIComponent(t('作品已创建，接下来在「版本」里新建它的版本'))}`, 303);
  } catch (e) {
    return Astro.redirect(withParams(Astro.url, { err: errorText(e, t) }), 303);
  }
}
---

<Admin title={t('新建作品')}>
  <form method="post" class="panel">
    <div class="form-grid">
      <label for="id">ID</label>
      <input id="id" type="text" name="id" required pattern="[a-z0-9][a-z0-9\-]*" placeholder={t('rtcd-014（小写字母、数字、连字符）')} />
    </div>
    <ReleaseFields />
    <p class="muted">{t('保存后在作品页新建它的版本（实体 CD、CD 抓轨、官方数字版、图片……），数量和名称不限。')}</p>
    <button class="primary" type="submit">{t('创建')}</button>
  </form>
</Admin>

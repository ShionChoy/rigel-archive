---
// 版本页: one edition as an album tag editor (like Picard / Mp3tag): 版本信息 (the tags every track shares;
// changing one changes all tracks, or the selected ones), its covers, 归档信息 (only for this site, never
// written into files), the track list with every track's tags (the file's own next to the row's), and all
// its files. An edition without tracks (scans, a PV) shows its information, cover and files.
import Admin from '../../../layouts/Admin.astro';
import Dialogs from '../../../components/desk/Dialogs.astro';
import FolderIcon from '../../../components/desk/FolderIcon.astro';
import PlacePicker from '../../../components/PlacePicker.astro';
import { FILE_KIND_LABELS, RIGHTS_LABELS } from '../../../lib/constants';
import { editionCovers } from '../../../lib/covers';
import { db, parseFormat, type EditionRow, type FileRow, type ReleaseRow } from '../../../lib/db';
import {
  EDITION_STATUSES, EDITION_STATUS_LABELS, deleteEdition, editionAudio, generateEditionTracks, loadEditions, matchEditionFiles, parseIds, saveEdition,
} from '../../../lib/editions';
import { editorData } from '../../../lib/edition-editor';
import { formatBytes, formatSpec, withParams } from '../../../lib/format';
import { ChangeSet, batchSince } from '../../../lib/changes';
import { N_, errorText, summary, UserError } from '../../../lib/i18n';
import { Places, folderKey } from '../../../lib/locations';
import { imageSrc } from '../../../lib/media';
import { derivedFor } from '../../../lib/processing';
import { COVER_SQL } from '../../../lib/tagedit';
import { editionContext, nameParts, preloadOriginals, taggedSource } from '../../../lib/tags';
import { NAMING_PRESETS } from '../../../lib/naming';
import { NEW_TYPE } from '../../../lib/types';
import { rightsOf, setRights } from '../../../lib/rights';
import { siteLangOf } from '../../../lib/public/paths';
import { PUBLIC_EDITION_STATUSES } from '../../../lib/public/rules';

const { id } = Astro.params;
const { t, lang } = Astro.locals;
const database = db();
const edition = await database.prepare('SELECT * FROM editions WHERE id = ?').bind(id).first<EditionRow>();
if (!edition) return new Response(t('找不到版本'), { status: 404 });
const release = (await database
  .prepare('SELECT r.*, e.name AS era_name FROM releases r JOIN eras e ON e.id = r.era_id WHERE r.id = ?')
  .bind(edition.release_id)
  .first<ReleaseRow & { era_name: string }>())!;

if (Astro.request.method === 'POST') {
  const started = new Date().toISOString();
  const form = await Astro.request.formData();
  const actor = Astro.locals.admin!.email;
  const saved = (n: number) => (n ? t('已保存（{n} 处改动）', { n }) : t('没有改动'));
  try {
    let msg: string;
    switch (form.get('section')) {
      case 'info':
        msg = saved(await saveEdition(actor, release, edition, form));
        break;
      case 'delete':
        await deleteEdition(actor, release, edition);
        return Astro.redirect(`/admin/releases/${release.id}?msg=${encodeURIComponent(t('已删除版本'))}`, 303);
      case 'generate':
        msg = t('已生成曲目表（{n} 处改动）', { n: await generateEditionTracks(actor, release, edition) });
        break;
      case 'match': {
        const r = await matchEditionFiles(actor, release, edition);
        msg = r.left ? t('已对应 {n} 个文件，{left} 个没找到对应曲目，请手动选择', { n: r.matched, left: r.left }) : t('已对应 {n} 个文件', { n: r.matched });
        break;
      }
      case 'rights': {
        const n = await setRights(actor, release, [edition], form.get('rights'), form.get('scope') === 'all');
        msg = n ? t('已设定 {n} 个文件的权属', { n }) : t('没有改动');
        break;
      }
      case 'cover': {
        // An edition without a track list: its cover is one of its pictures (or, unset, one named like a cover).
        const fileId = String(form.get('cover_file_id') ?? '') || null;
        if (fileId) {
          const ok = await database.prepare(`SELECT 1 FROM files WHERE id = ? AND edition_id = ? AND ${COVER_SQL}`).bind(fileId, edition.id).first();
          if (!ok) throw new UserError('封面要从这个版本的 JPEG / PNG 图片里选（12 MB 以内）');
        }
        const cs = new ChangeSet(database, actor, summary(fileId ? N_('版本 {edition}：设置封面') : N_('版本 {edition}：取消封面'), { edition: `${release.catalog_no ?? release.title} ${edition.name}`.trim() }));
        cs.updateKnown('edition', { id: edition.id }, { cover_file_id: edition.cover_file_id }, { cover_file_id: fileId });
        msg = saved(await cs.commit());
        break;
      }
      default:
        throw new UserError('未知的表单');
    }
    const undo = await batchSince(database, actor, started);
    return Astro.redirect(withParams(Astro.url, { msg, err: null, undo }) + (form.get('anchor') ? `#${form.get('anchor')}` : ''), 303);
  } catch (e) {
    return Astro.redirect(withParams(Astro.url, { err: errorText(e, t), msg: null }), 303);
  }
}

const places = await Places.load();
type F = Pick<
  FileRow,
  'id' | 'name' | 'download_name' | 'ext' | 'size' | 'kind' | 'state' | 'dir' | 'folder_id' | 'track_id' | 'format' | 'sha256' | 'blob_key' | 'origin' | 'mtime'
  | 'edition_id' | 'sealed' | 'rights'
> & { old: number };
const [siblings, filesResult, audio] = await Promise.all([
  loadEditions(release.id, places.types),
  database
    .prepare(
      `SELECT id, name, download_name, ext, size, kind, state, dir, folder_id, track_id, format, sha256, blob_key, origin, mtime, edition_id, sealed, rights,
              EXISTS (SELECT 1 FROM files n WHERE n.replaces = f.id) AS old
       FROM files f WHERE edition_id = ? AND sealed_in IS NULL ORDER BY coalesce(download_name, name)`,
    )
    .bind(edition.id)
    .all<F>(),
  editionAudio(edition.id),
]);
const files = filesResult.results;
const editor = await editorData(edition, release, places, t);
const withTracks = editor.rows.length > 0 || audio.length > 0;
const ids = parseIds(edition.external_ids);
const label = places.editionLabel(edition, t);
const home = places.editionFolder(edition.id);
const totalBytes = files.reduce((n, f) => n + f.size, 0);
// The files as a tree below the edition's folder. scripts/edition-files.ts makes it a small file manager
// (select, move, rename, ignore, delete, new folders, drag onto folders), with the 整理台's operations.
interface Node { id: string; name: string; files: F[]; kids: Node[]; count: number }
const build = (folderId: string): Node => {
  const f = places.folders.get(folderId)!;
  const own = files.filter((x) => x.folder_id === folderId);
  const kids = places.children(folderId).map((c) => build(c.id));
  return { id: folderId, name: places.folderName(f, t), files: own, kids, count: own.length + kids.reduce((n, k) => n + k.count, 0) };
};
const tree = home ? build(home.id) : null;
const flat: { depth: number; node?: Node; file?: F; parent: string | null }[] = [];
const walk = (node: Node, depth: number, parent: string | null) => {
  flat.push({ depth, node, parent });
  for (const f of node.files) flat.push({ depth: depth + 1, file: f, parent: node.id });
  for (const k of node.kids) walk(k, depth + 1, node.id);
};
if (tree) walk(tree, 0, null);
const folderRole = (depth: number) => (depth === 0 ? 'root' : 'plain');
// What the tagged downloads are called (the team's template, lib/naming.ts), and a few rows to try templates on.
const ctx = withTracks ? await editionContext(edition.id) : null;
if (ctx) await preloadOriginals(ctx, files.map((f) => f.sha256));
const taggedNames = new Map<string, string>();
if (ctx) {
  for (const f of files) {
    if (f.kind !== 'audio' || !f.blob_key) continue;
    const src = await taggedSource(f, ctx);
    if (src) taggedNames.set(f.id, src.name);
  }
}
const rowOfFile = new Map(editor.rows.flatMap((r) => r.files.map((fid) => [fid, r.id] as const)));
const namingData = ctx
  ? {
    template: ctx.naming,
    presets: NAMING_PRESETS,
    samples: ctx.rows.flatMap((row) => {
      const f = files.find((x) => x.track_id === row.track_id && x.kind === 'audio');
      return f ? [{ parts: nameParts(ctx, row, f.sha256), ext: (taggedNames.get(f.id) ?? f.name).split('.').pop() ?? f.ext }] : [];
    }).slice(0, 3),
  }
  : null;
const firstTrackFile = ctx?.rows.map((r) => files.find((x) => x.track_id === r.track_id && x.kind === 'audio')).find((f) => !!f);
const sampleName = firstTrackFile ? taggedNames.get(firstTrackFile.id) ?? null : null;
const coverable = (f: F) => (f.kind === 'image' && /^(jpe?g|png)$/i.test(f.ext)) || f.kind === 'audio';
// 「整理非音频文件…」 offers the files directly in the edition's folder that are not audio, nor an archive kept whole.
const loose = (f: F) => f.folder_id === home?.id && f.kind !== 'audio' && !f.sealed;
const looseRoot = files.filter(loose).length;
const rowOfTrack = new Map(editor.rows.map((r) => [r.track_id, r]));
// Pictures for an edition without tracks: a gallery, and its cover.
const images = files.filter((f) => f.kind === 'image' && f.state !== 'ignored');
const derived = await derivedFor(database, images.map((f) => f.sha256));
const thumb = (f: F, size: 240 | 640 = 240) => imageSrc(f.blob_key ? `/admin/media/${f.blob_key}` : null, f.sha256 ? derived.get(f.sha256) : undefined, size);
const covers = withTracks ? [] : (await editionCovers([edition.id])).get(edition.id) ?? [];
const coverChoices = images.filter((f) => /^(jpe?g|png)$/i.test(f.ext) && f.size < 12_000_000);
const kindLabel = (k: string) => t(FILE_KIND_LABELS[k] ?? k);
// 公开站: whether the public site shows this edition (a published work, an edition collected at least in
// part) and which of its files (by their rights, lib/public/rules.ts).
const rights = (await rightsOf([edition.id])).get(edition.id)!;
const workPublished = release.state === 'published';
const editionShown = PUBLIC_EDITION_STATUSES.includes(edition.status);
const publicHref = `/${siteLangOf(lang)}/works/${release.id}/?edition=${edition.id}`;
---

<Admin title={`${release.catalog_no ? `${release.catalog_no} ` : ''}${release.title} · ${label}`} wide heading={false}>
  <nav class="crumbs">
    {places.chain(`ed:${edition.id}`).slice(0, -1).map((k, i) => <>{i > 0 && ' / '}<a href={places.folderOf(k)?.release_id ? `/admin/releases/${release.id}` : `/admin/inbox?loc=${k}`}>{places.name(k, t)}</a></>)}
    {' / '}<span class="muted">{t('版本')}</span>
  </nav>
  <header class="ed-head">
    <h1>
      {label}
      {(edition.catalog_no ?? release.catalog_no) && <span class="ed-catalog">{edition.catalog_no ?? release.catalog_no}</span>}
      <span class={`chip ${edition.status}`}>{t(EDITION_STATUS_LABELS[edition.status])}</span>
    </h1>
    <div class="ed-actions">
      {withTracks && <button type="button" class="primary" data-act="lookup">{t('查找元数据…')}</button>}
      <a class="button" href={`/admin/editions/${edition.id}/zip`}>{withTracks ? t('下载本版（带标签 zip）') : t('下载本版（zip）')}</a>
      <a class="button" href={`/admin/releases/${release.id}/preview?edition=${edition.id}`}>{t('预览公开页')}</a>
      <a class="button" href={`/admin/history?release=${release.id}`}>{t('修改记录')}</a>
    </div>
  </header>

  <section class="panel ed-public" id="public">
    <h2>{t('公开站')}</h2>
    <p class="pub-line">
      {!workPublished ? (
        <><span class="chip unknown">{t('不显示')}</span> {t('作品还是草稿。')} <a href={`/admin/releases/${release.id}#info`}>{t('到作品页发布 ›')}</a></>
      ) : !editionShown ? (
        <><span class="chip unknown">{t('不显示')}</span> {t('本版状态为「{status}」：只有已收录、部分缺档的版本显示在公开站。', { status: t(EDITION_STATUS_LABELS[edition.status]) })}</>
      ) : (
        <><span class="chip collected">{t('显示中')}</span> {t('作品已发布，本版显示在作品页。')} <a href={publicHref}>{t('在公开站打开 ›')}</a></>
      )}
    </p>
    {rights.total > 0 ? (
      <>
        <p class="pub-line">
          {t('本版 {n} 个文件的权属：', { n: rights.total })}
          {(['own', 'licensed', 'third_party', 'unknown'] as const).filter((r) => rights[r] > 0).map((r) => <span class={`chip ${r}`}>{t(RIGHTS_LABELS[r])} {rights[r]}</span>)}
          {rights.unknown > 0 && <b class="pub-warn">{t('权属未定的 {n} 个文件在公开站不显示。', { n: rights.unknown })}</b>}
        </p>
        <form method="post" class="inline-form pub-form">
          <input type="hidden" name="section" value="rights" />
          <input type="hidden" name="anchor" value="public" />
          {t('批量设定权属：')}
          <select name="scope" aria-label={t('哪些文件')}>
            {rights.unknown > 0 && <option value="unknown">{t('权属未定的 {n} 个文件', { n: rights.unknown })}</option>}
            <option value="all">{t('本版全部 {n} 个文件', { n: rights.total })}</option>
          </select>
          <span aria-hidden="true">→</span>
          <select name="rights" aria-label={t('权属')}>
            {(['own', 'licensed', 'third_party'] as const).map((r) => <option value={r}>{t(RIGHTS_LABELS[r])}</option>)}
          </select>
          <button type="submit" class:list={{ primary: rights.unknown > 0 }}>{t('设定')}</button>
        </form>
        <p class="muted small">{t('公开站播放和展示社团自有、已获授权的文件；第三方的只列名称；权属未定的不显示。单个文件可以在下面「文件」里右键设定。')}</p>
      </>
    ) : <p class="muted small">{t('本版还没有文件。')}</p>}
  </section>

  {withTracks ? (
    <div class="ed-top">
      <section class="panel ed-info" id="ed-info" aria-live="polite"><p class="muted">{t('正在载入…')}</p></section>
      <aside class="panel ed-cover" id="ed-cover"></aside>
    </div>
  ) : (
    <div class="ed-top">
      <section class="panel ed-info">
        <h2>{t('版本信息')} <small class="muted">{t('这个版本没有曲目，只有版本信息和文件')}</small></h2>
        <dl class="kv ed-kv">
          <dt>{t('类型')}</dt><dd>{places.types.label(edition.slot, t)}</dd>
          <dt>{t('名称')}</dt><dd>{edition.name || '—'}</dd>
          <dt>{t('编号')}</dt><dd>{edition.catalog_no ?? '—'}</dd>
          <dt>{t('日期')}</dt><dd>{edition.release_date ?? '—'}</dd>
          <dt>{t('状态')}</dt><dd><span class={`chip ${edition.status}`}>{t(EDITION_STATUS_LABELS[edition.status])}</span></dd>
          <dt>{t('来源')}</dt><dd>{edition.source ?? '—'}</dd>
          <dt>{t('说明')}</dt><dd class="pre">{edition.note ?? '—'}</dd>
        </dl>
        <p class="muted small">{t('在下面「归档信息」里修改。')}</p>
      </section>
      <aside class="panel ed-cover">
        <h2>{t('封面')}</h2>
        {covers[0] ? (
          <>
            <a href={covers[0].full} target="_blank" rel="noopener"><img class="ed-cover-img" src={covers[0].src} alt="" /></a>
            <p><b>{covers[0].file?.name}</b></p>
            <p class="muted small">
              {[covers[0].width && covers[0].height ? `${covers[0].width} × ${covers[0].height}` : '', covers[0].size ? formatBytes(covers[0].size) : ''].filter(Boolean).join(' · ')}<br />
              {covers[0].source === 'chosen' ? t('手动指定') : t('未手动指定：默认用文件名像封面（cover、front、封面…）的图片，没有就用第一张')}
            </p>
          </>
        ) : <p class="muted">{t('还没有图片。')}</p>}
        {coverChoices.length > 0 && (
          <form method="post" class="cover-pick">
            <input type="hidden" name="section" value="cover" />
            <select name="cover_file_id" aria-label={t('封面')}>
              <option value="">{t('（自动选择）')}</option>
              {coverChoices.map((f) => <option value={f.id} selected={edition.cover_file_id === f.id}>{f.download_name || f.name}</option>)}
            </select>
            <button type="submit">{t('更换封面')}</button>
          </form>
        )}
      </aside>
    </div>
  )}

  <form method="post" class="panel ed-archive" id="archive">
    <input type="hidden" name="section" value="info" />
    <input type="hidden" name="anchor" value="archive" />
    <h2>{t('归档信息')} <small class="muted">{t('只在本站使用，不写入文件')}</small></h2>
    <div class="archive-grid">
      <label for="slot">{t('类型')}</label>
      <span>
        <select id="slot" name="slot" data-type-select>
          {places.types.options(t).map((o) => <option value={o.id} selected={edition.slot === o.id}>{o.label}</option>)}
          <option value={NEW_TYPE}>{t('＋ 新类型…')}</option>
        </select>
        <input type="text" name="new_type" maxlength="40" data-new-type hidden placeholder={t('新类型名称')} />
      </span>
      <label for="name">{t('名称')}</label>
      <input id="name" type="text" name="name" value={edition.name} placeholder={t('如「初版」「第 2 版」「Bandcamp」「扫图集」')} />
      <label for="status">{t('状态')}</label>
      <select id="status" name="status">{EDITION_STATUSES.map((s) => <option value={s} selected={edition.status === s}>{t(EDITION_STATUS_LABELS[s])}</option>)}</select>
      <label for="track_count">{t('声明曲数')}</label>
      <input id="track_count" type="number" name="track_count" value={edition.track_count ?? ''} min="0" max="999" />
      <label for="catalog_no">{t('编号')}</label>
      <input id="catalog_no" type="text" name="catalog_no" value={edition.catalog_no ?? ''} placeholder="RTCD-004A" />
      <label for="release_date">{t('发行日')}</label>
      <input id="release_date" type="text" name="release_date" value={edition.release_date ?? ''} placeholder="YYYY-MM-DD" />
      <label for="source">{t('来源')}</label>
      <input id="source" type="text" name="source" value={edition.source ?? ''} placeholder={t('商店、平台或抓轨者')} />
      <label for="based_on">{t('源于')}</label>
      <select id="based_on" name="based_on">
        <option value="">{t('（无）')}</option>
        {siblings.filter((e) => e.id !== edition.id).map((e) => <option value={e.id} selected={edition.based_on === e.id}>{places.editionLabel(e, t)}</option>)}
      </select>
      <label for="musicbrainz_release">MusicBrainz</label>
      <span class="with-link">
        <input id="musicbrainz_release" type="text" name="musicbrainz_release" value={ids.musicbrainz_release ?? ''} placeholder={t('发行 ID')} />
        {ids.musicbrainz_release && <a href={`https://musicbrainz.org/release/${ids.musicbrainz_release}`} target="_blank" rel="noopener">↗</a>}
      </span>
      <label for="bandcamp">Bandcamp</label>
      <span class="with-link">
        <input id="bandcamp" type="text" name="bandcamp" value={ids.bandcamp ?? ''} placeholder="https://….bandcamp.com/album/…" />
        {ids.bandcamp && <a href={ids.bandcamp} target="_blank" rel="noopener">↗</a>}
      </span>
      <label for="note">{withTracks ? t('备注') : t('说明')}</label>
      <textarea id="note" name="note" class="wide">{edition.note ?? ''}</textarea>
    </div>
    <p><label class="inline-check"><input type="checkbox" name="is_default" value="1" checked={!!edition.is_default} /> {t('公开页默认显示这个版本')}</label></p>
    <p><button class="primary" type="submit">{t('保存归档信息')}</button> <span class="muted small" data-archive-note hidden>{t('上面的标签改动还没保存，先保存或放弃它们')}</span></p>
  </form>

  {withTracks ? (
    <section class="panel ed-tracks" id="tracks">
      {editor.rows.length === 0 ? (
        <>
          <h2>{t('曲目列表')}</h2>
          <p class="muted">{t('这个版本还没有曲目表。可以从版本里的音频文件生成（标题取自文件），或用「查找元数据」从 MusicBrainz、Bandcamp 导入。生成后就可以在这里编辑每首的标签。')}</p>
          <form method="post" class="inline">
            <input type="hidden" name="section" value="generate" />
            <input type="hidden" name="anchor" value="tracks" />
            <button class="primary" type="submit">{t('从 {n} 个音频文件生成曲目表', { n: audio.length })}</button>
          </form>
        </>
      ) : <p class="muted">{t('正在载入…')}</p>}
    </section>
  ) : (
    <section class="panel ed-notracks">
      <span class="muted">{t('这个版本没有曲目表。')}</span>
      <button type="button" disabled title={t('版本里没有音频文件；需要曲目表时，先把音频放进这个版本')}>{t('＋ 添加曲目表')}</button>
      <span class="muted small">{t('（需要时也可以加，比如附带曲目的特典：先把音频放进这个版本）')}</span>
    </section>
  )}

  <section class="panel ed-files" id="files" data-home={home?.id ?? ''}>
    <div class="files-head">
      <h2>{t('文件')} <small class="muted">{t('本版全部文件与文件夹 · {n} 个文件 · {size}', { n: files.length, size: formatBytes(totalBytes) })}</small></h2>
      {sampleName && (
        <p class="naming small">
          {t('带标签下载的文件名')}：<code data-naming-sample>{sampleName}</code>
          <button type="button" class="link" data-files-act="naming">{t('更改格式…')}</button>
        </p>
      )}
    </div>
    {!withTracks && images.length > 0 && (
      <div class="gallery">
        {images.map((f) => {
          const fmt = parseFormat(f.format);
          return (
            <a class="shot" href={`/admin/files/${f.id}`}>
              <img src={thumb(f, 640) ?? ''} alt="" loading="lazy" />
              <span>{f.download_name || f.name}</span>
              <span class="muted small">{fmt.width && fmt.height ? `${fmt.width}×${fmt.height}` : formatBytes(f.size)}</span>
            </a>
          );
        })}
      </div>
    )}
    {home && (
      <div class="files-bar" data-files-bar>
        <div class="files-bar-idle">
          <button type="button" data-files-act="new-folder" title="Ctrl+Shift+N">{t('＋ 新建文件夹')}</button>
          <a class="button" href={`/admin/upload?place=${folderKey(home.id)}`}>{t('上传到本版…')}</a>
          {withTracks && looseRoot > 0 && (
            <button type="button" data-files-act="tidy" title={t('把本版根目录里的 {n} 个非音频文件（LOG、CUE、图片、说明等）一次移进一个文件夹：可以选已有的，也可以新建', { n: looseRoot })}>
              {t('整理非音频文件…')}
            </button>
          )}
          <span class="muted small">{t('勾选文件或文件夹后可以移动、重命名、忽略、删除；也可以右键，或把它们拖到文件夹上。')}</span>
        </div>
        <div class="files-bar-sel" hidden>
          <span class="count" set:html={t('已选 {n} 个', { n: '<b data-count>0</b>' })} />
          <button type="button" data-files-act="move" title="M">{t('移动到…')}</button>
          <button type="button" data-files-act="rename" title="F2">{t('重命名')}</button>
          <button type="button" data-files-act="ignore" title={t('忽略：这些文件不再整理，并移出本版（在整理台「已忽略」里可以找回）')}>{t('忽略')}</button>
          <button type="button" data-files-act="delete" class="danger" title="Delete">{t('删除')}</button>
          <button type="button" data-files-act="more">{t('更多…')}</button>
          <button type="button" class="link" data-files-act="clear" title="Esc">{t('取消选择')}</button>
        </div>
      </div>
    )}
    {flat.length > 0 && (
      <table class="grid files-tree" data-files-table>
        <thead>
          <tr>
            <th class="sel"><input type="checkbox" data-sel-all aria-label={t('全选')} /></th>
            <th>{t('名称')}</th><th>{t('类型')}</th><th>{t('规格')}</th><th class="num">{t('大小')}</th><th>{t('权属')}</th><th>{t('下载')}</th><th class="row-menu"></th>
          </tr>
        </thead>
        <tbody>
          {flat.map(({ depth, node, file: f, parent }) => node ? (
            <tr
              class="folder-row" data-key={`d:${node.id}`} data-role={folderRole(depth)} data-name={node.name} data-parent={parent ?? ''}
              data-depth={depth} draggable={folderRole(depth) === 'plain' ? 'true' : undefined}
            >
              <td class="sel">{depth > 0 && <input type="checkbox" data-sel aria-label={t('选择 {name}', { name: node.name })} />}</td>
              <td style={`--depth:${depth}`} class="tree-name">
                <FolderIcon kind={depth === 0 ? 'edition' : 'plain'} />
                <a class="fname" href={`/admin/inbox?loc=${folderKey(node.id)}`} title={t('在整理台中显示')}>{node.name}</a>
              </td>
              <td colspan="5" class="muted small">{node.count ? t('{n} 个文件', { n: node.count }) : t('空文件夹')}</td>
              <td class="row-menu"><button type="button" class="link" data-row-menu aria-label={t('更多操作')} title={t('更多操作')}>⋯</button></td>
            </tr>
          ) : f ? (
            <tr
              class:list={['file-row', { muted: f.state === 'ignored' || !!f.old }]} data-key={`f:${f.id}`} data-kind={f.kind} data-ext={f.ext}
              data-name={f.download_name || f.name} data-orig={f.name} data-origin={f.origin} data-parent={parent ?? ''} data-state={f.state}
              data-row={rowOfFile.get(f.id)} data-cover={coverable(f) ? '1' : undefined} data-tagged={taggedNames.has(f.id) ? '1' : undefined}
              data-blob={f.blob_key ? '1' : undefined} data-loose={loose(f) ? kindLabel(f.kind) : undefined} draggable="true"
            >
              <td class="sel"><input type="checkbox" data-sel aria-label={t('选择 {name}', { name: f.download_name || f.name })} /></td>
              <td style={`--depth:${depth}`} class="tree-name">
                <a class="fname" href={`/admin/files/${f.id}`} title={f.download_name && f.download_name !== f.name ? t('原文件名：{name}', { name: f.name }) : undefined}>{f.download_name || f.name}</a>
                {f.track_id && rowOfTrack.get(f.track_id) && <span class="muted small"> → {t('第 {n} 首', { n: rowOfTrack.get(f.track_id)!.position })}</span>}
                {f.old ? <span class="chip ignored">{t('旧版本')}</span> : null}
                {f.state === 'ignored' && <span class="chip ignored">{t('已忽略')}</span>}
              </td>
              <td>{kindLabel(f.kind)}</td>
              <td class="spec">{formatSpec(parseFormat(f.format))}</td>
              <td class="num">{formatBytes(f.size)}</td>
              <td>{f.state !== 'ignored' && !f.old && <span class={`chip ${f.rights}`}>{t(RIGHTS_LABELS[f.rights])}</span>}</td>
              <td class="downloads">
                {taggedNames.has(f.id) && <a href={`/admin/download/${f.id}?tagged=1`} title={t('下载为「{name}」', { name: taggedNames.get(f.id)! })}>{t('带标签')}</a>}
                {f.blob_key && <a href={`/admin/download/${f.id}`} title={t('下载为「{name}」（与收录时完全相同）', { name: f.download_name || f.name })}>{f.kind === 'audio' ? t('原件') : t('下载')}</a>}
              </td>
              <td class="row-menu"><button type="button" class="link" data-row-menu aria-label={t('更多操作')} title={t('更多操作')}>⋯</button></td>
            </tr>
          ) : null)}
        </tbody>
      </table>
    )}
    {files.length === 0 && <p class="muted">{t('还没有文件放进这个版本。在整理台把文件「移动到…」这个版本，或点「上传到本版…」。')}</p>}
  </section>

  <form method="post" class="panel danger-zone" id="ed-delete">
    <input type="hidden" name="section" value="delete" />
    <b>{t('删除版本')}</b>
    <p class="muted">{t('只能删除没有文件的版本（里面的空文件夹一起删除）；它的曲目表一并删除，可在修改记录里撤销。')}</p>
    <button class="danger" type="submit" disabled={files.length > 0}>{t('删除这个版本')}</button>
  </form>

  <div id="desk-menu" class="ctx-menu" role="menu" hidden></div>
  <div id="desk-drag" class="drag-label" hidden></div>
  <div id="desk-toast" class="desk-toast page-toast" role="status" aria-live="polite" hidden>
    <span data-text></span>
    <button type="button" data-act="undo-toast" hidden>{t('撤销')}</button>
    <button type="button" class="link" data-act="close-toast" aria-label={t('关闭')}>×</button>
  </div>
  <PlacePicker places={places} />
  <Dialogs types={places.types} />
  {home && (
    <dialog id="dlg-tidy" class="dlg">
      <form method="dialog">
        <h3>{t('整理非音频文件')}</h3>
        <p class="muted small">{t('把本版根目录里的非音频文件（LOG、CUE、图片、说明等）移进一个文件夹。勾选要移动的种类，再选放进哪个文件夹。')}</p>
        <fieldset class="tidy-set">
          <legend>{t('移动哪些')}</legend>
          <div data-kinds></div>
        </fieldset>
        <fieldset class="tidy-set">
          <legend>{t('放进')}</legend>
          <div data-folders></div>
          <label class="inline-check tidy-new">
            <input type="radio" name="tidy-target" value="new" /> {t('新建文件夹')}
            <input type="text" data-new maxlength="200" aria-label={t('新文件夹名称')} />
          </label>
          <p class="muted small">{t('新文件夹建在本版根目录；那里已有同名文件夹时，文件直接放进它。')}</p>
        </fieldset>
        <p class="err-line" data-err></p>
        <div class="dlg-buttons">
          <button value="cancel">{t('取消')}</button>
          <button value="ok" class="primary" data-ok>{t('移动')}</button>
        </div>
      </form>
    </dialog>
  )}
  {namingData && (
    <dialog id="dlg-naming" class="dlg wide">
      <form method="dialog">
        <h3>{t('带标签下载的文件名')}</h3>
        <p class="muted small">{t('整个管理组共用，所有版本的带标签下载和整版 zip 都按这个格式命名。下载原件时仍用文件自己的名字（在本页或整理台重命名文件即可改）。')}</p>
        <div class="naming-presets" data-presets></div>
        <label class="naming-custom">
          <input type="radio" name="naming" value="custom" /> {t('自定义')}
          <input type="text" data-custom maxlength="200" spellcheck="false" />
        </label>
        <p class="muted small">{t('字段：{tracknumber} 两位曲号 · {discnumber} 碟号（只有多碟的版本才有）· {title} 标题 · {artist} 艺术家 · {album} 专辑 · {albumartist} 专辑艺术家 · {date} 日期 · {catalognumber} 编号；其他标签写 Picard 的标签名。[ ] 里的内容只在其中的字段都有值时出现。')}</p>
        <div class="naming-preview" data-preview></div>
        <p class="err-line" data-err></p>
        <div class="dlg-buttons">
          <button value="cancel">{t('取消')}</button>
          <button value="ok" class="primary" data-ok>{t('保存')}</button>
        </div>
      </form>
      <script type="application/json" data-naming set:html={JSON.stringify(namingData).replace(/</g, '\\u003c')} />
    </dialog>
  )}

  {withTracks && (
    <>
      <div class="ed-savebar" hidden>
        <span data-dirty></span>
        <button type="button" data-act="discard">{t('放弃')}</button>
        <button type="button" class="primary" data-act="save">{t('保存')}</button>
      </div>
      <dialog id="dlg-cover" class="dlg dlg-wide">
        <form method="dialog">
          <h3 data-title></h3>
          <p class="muted small" data-now></p>
          <div class="tabs" role="tablist">
            <button type="button" data-tab="file" class="on">{t('本版本的图片')}</button>
            <button type="button" data-tab="embedded">{t('曲目自带的封面')}</button>
            <button type="button" data-tab="upload">{t('上传图片')}</button>
          </div>
          <div class="pick-grid" data-grid></div>
          <div class="upload-box" data-upload hidden>
            <input type="file" accept="image/jpeg,image/png" data-file />
            <span class="muted small">{t('上传的图片放在本版根目录，之后可以在「文件」里移到别的文件夹。')}</span>
          </div>
          <div class="form-grid compact">
            <label>{t('用于')}</label>
            <span>
              <label class="inline-check"><input type="radio" name="scope" value="all" checked /> <span data-all></span></label>
              <label class="inline-check"><input type="radio" name="scope" value="selected" /> <span data-sel></span></label>
            </span>
            <label>{t('方式')}</label>
            <span>
              <label class="inline-check"><input type="radio" name="mode" value="replace" checked /> {t('替换正面封面（其他图片保留）')}</label>
              <label class="inline-check"><input type="radio" name="mode" value="add" /> {t('追加一张图片')}</label>
            </span>
          </div>
          <p class="muted small">{t('可选 JPEG / PNG；超过 12 MB 的高清扫图，下载时嵌入处理程序缩成 1600 px 的副本，原图不变。')}</p>
          <p class="err-line" data-err></p>
          <div class="dlg-buttons">
            <button value="restore" data-restore>{t('恢复为曲目自带')}</button>
            <button value="cancel">{t('取消')}</button>
            <button value="ok" class="primary" data-ok>{t('应用')}</button>
          </div>
        </form>
      </dialog>
      <dialog id="dlg-addtag" class="dlg">
        <form method="dialog">
          <h3>{t('添加标签')}</h3>
          <p class="muted small" data-scope></p>
          <select name="name" data-names size="12"></select>
          <label class="block">{t('或自定义标签名')}<input type="text" name="custom" maxlength="60" placeholder="my_field" /></label>
          <div class="dlg-buttons">
            <button value="cancel">{t('取消')}</button>
            <button value="ok" class="primary">{t('添加')}</button>
          </div>
        </form>
      </dialog>
      <dialog id="dlg-display" class="dlg dlg-wide">
        <form method="dialog">
          <h3>{t('显示哪些标签')}</h3>
          <p class="muted small">{t('勾选的标签即使为空也显示在「版本信息」和曲目详情里（整个管理组共用）。常用标签总是显示；有值的标签无论是否勾选都会显示。')}</p>
          <div class="display-grid" data-list></div>
          <div class="dlg-buttons">
            <button value="cancel">{t('取消')}</button>
            <button value="ok" class="primary">{t('保存')}</button>
          </div>
        </form>
      </dialog>
      <aside class="lookup-panel" id="lookup" hidden></aside>
      <script type="application/json" id="ed-data" set:html={JSON.stringify(editor).replace(/</g, '\\u003c')} />
    </>
  )}
</Admin>

<script>
  import '../../../scripts/edition';
  import '../../../scripts/edition-files';
  for (const el of Array.from(document.querySelectorAll('[data-type-select]'))) {
    const select = el as unknown as HTMLSelectElement;
    const extra = Array.from(select.form?.querySelectorAll('[data-new-type]') ?? []) as unknown as HTMLElement[];
    select.addEventListener('change', () => extra.forEach((x) => (x.hidden = select.value !== '__new__')));
  }
</script>

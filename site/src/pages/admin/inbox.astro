---
// 整理台: an explorer over the archive, laid out like the Windows file explorer. Left: fixed entries,
// 快速访问, two trees of the same kind — 未归档 (the files still to organize, by their original folders)
// and 已归档 (the folder tree: eras, releases and editions are folders of their type) — whose open folders
// list their files too, and 智能文件夹. Middle: the open folder (subfolders first, then files) or list.
// Right: the inspector. scripts/desk.ts adds selection, the right-click menu, drag and drop (from either
// tree or the middle onto any folder), the keyboard and loading without page reloads.
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import Bare from '../../components/Bare.astro';
import Dialogs from '../../components/desk/Dialogs.astro';
import FolderIcon from '../../components/desk/FolderIcon.astro';
import FolderTree from '../../components/desk/FolderTree.astro';
import Inspector from '../../components/desk/Inspector.astro';
import PlacePicker from '../../components/PlacePicker.astro';
import {
  ARCHIVE_STATUS_LABELS, FILE_KIND_LABELS, FILE_STATES, FILE_STATE_LABELS, RIGHTS, RIGHTS_LABELS,
  ROLE_LABELS,
} from '../../lib/constants';
import { db, parseFormat, parseSuggestion, type FileRow, type Suggestion } from '../../lib/db';
import { formatBytes, formatSpec, percent, withParams } from '../../lib/format';
import { keptMessage, originalGone } from '../../lib/deletion';
import { errorText, summaryText, UserError, type T } from '../../lib/i18n';
import {
  ARCHIVE_VIEW, FIXED_VIEWS, applyInboxAction, browsing, underDir, deskOrder, deskWhere, idsForQuery, idsInDirs, parseInboxAction, readDeskQuery, sourceChildren, viewCounts,
  type ActionResult, type DeskQuery,
} from '../../lib/inbox';
import { Places, UNPLACED_SQL, folderKey, folderTree, isArchive, split, type LocNode } from '../../lib/locations';
import { guessRelease, loadQuickAccess } from '../../lib/folders';
import { ORIGINS, PRESETS, RULE_FIELDS, RULE_OPS, SUGGEST_KINDS, loadSmartFolders, presetOf, type RuleSet } from '../../lib/smart';
import { EDITION_PROBLEMS, editionProblems, type EditionProblem } from '../../lib/checks';
import { folderView, trashBatches } from '../../lib/desk';
import { loadForms } from '../../lib/forms';
import { derivedFor } from '../../lib/processing';
import { audioThumbs } from '../../lib/covers';
import { readNow } from '../../lib/embedded';
import { imageSrc } from '../../lib/media';
import { graceDays } from '../../lib/storage';

const PAGE_SIZE = 200;
const url = Astro.url;
const { t } = Astro.locals;
const actor = Astro.locals.admin!.email;
const wantsJson = (Astro.request.headers.get('accept') ?? '').includes('application/json');
// Moving between folders, the page's script asks only for the middle and the inspector: no sidebar (its counts
// scan every file), no dialogs, no folder list for the script (it keeps its own until an action changes things).
const partial = Astro.request.headers.get('x-desk-part') === 'main';
const database = db();

/** The message shown after an action, in the admin's language. */
function resultMessage(r: ActionResult, deleting: boolean, tr: T): string {
  const done = summaryText(r.summary, tr);
  let head = deleting ? done : tr('{done}：实际改动 {n} 个', { done, n: r.changed });
  if (r.placed !== undefined || r.sealed) {
    const parts = [
      r.placed ? tr('{n} 个文件放入位置或按建议忽略', { n: r.placed }) : '',
      r.sealed?.archives ? tr('{n} 个压缩包整体收藏（{hidden} 个包内文件不再单独整理）', { n: r.sealed.archives, hidden: r.sealed.hidden }) : '',
    ].filter(Boolean);
    head = parts.length ? `${done}：${parts.join(tr('；'))}` : tr('{done}：没有改动', { done });
  }
  const skipped = r.skipped ? tr('，{n} 个没有可用建议或在整体收藏的包里，已跳过', { n: r.skipped }) : '';
  const low = r.lowConfidence ? tr('，{n} 个把握度低于 50% 已跳过（请逐个确认或手动移动）', { n: r.lowConfidence }) : '';
  const refused = r.refused?.length ? tr('；{names} 的包内已有文件归档，没有收起（先把它们退回待整理）', { names: r.refused.join('、') }) : '';
  const noType = r.noType ? tr('，{n} 个的建议用到的版本类型已被删除，已跳过（请手动移动）', { n: r.noType }) : '';
  // A long list of new editions is cut short (the whole list is in the history).
  const names = r.created && r.created.length > 5 ? tr('{names} 等', { names: r.created.slice(0, 5).join('、') }) : r.created?.join('、');
  const created = r.created?.length ? tr('；按建议新建了 {n} 个版本：{names}（可以在作品页改名或删除）', { n: r.created.length, names }) : '';
  return `${head}${skipped}${low}${noType}${refused}${created}${r.kept ? keptMessage(r.kept, tr) : ''}`;
}

/** What a large 「按建议归档」 would do (its preview), line by line. */
function planMessage(r: ActionResult, tr: T): string {
  const p = r.plan!;
  const lines = [tr('按建议归档 {n} 个文件：', { n: p.files })];
  if (r.placed) lines.push(tr('· {n} 个放入位置', { n: r.placed }));
  if (p.ignored) lines.push(tr('· {n} 个按建议忽略', { n: p.ignored }));
  if (r.sealed?.archives) lines.push(tr('· {n} 个压缩包整体收藏（{hidden} 个包内文件不再单独整理）', { n: r.sealed.archives, hidden: r.sealed.hidden }));
  if (p.editions || p.folders) lines.push(tr('· 新建 {editions} 个版本、{folders} 个文件夹', { editions: p.editions, folders: p.folders }));
  const skipped = r.skipped + r.lowConfidence + (r.noType ?? 0);
  if (skipped) lines.push(tr('· 跳过 {n} 个（没有可用建议、把握度低于 50%，或建议的版本类型已删除）', { n: skipped }));
  if (p.where.length) lines.push(tr('主要去向：'), ...p.where.map((w) => `    ${w.path} — ${w.n}`));
  if (r.created?.length) {
    const names = r.created.length > 5 ? tr('{names} 等', { names: r.created.slice(0, 5).join('、') }) : r.created.join('、');
    lines.push(tr('新建的版本：{names}', { names }));
  }
  if (r.refused?.length) lines.push(tr('{names} 的包内已有文件归档，不会收起', { names: r.refused.join('、') }));
  lines.push(tr('执行后可以在修改记录里整批撤销。'));
  return lines.join('\n');
}

// ---------------------------------------------------------------- actions on files (JSON from the page's script, or a plain form)
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const back = (params: Record<string, string | null>) => Astro.redirect(withParams(url, { msg: null, err: null, undo: null, ...params }), 303);
  try {
    const action = parseInboxAction(form);
    const places = await Places.load();
    let ids = form.getAll('ids').map(String);
    if (form.get('scope') === 'filter') {
      const q = readDeskQuery(url.searchParams, places);
      const smart = q.view.startsWith('sf:') ? (await loadSmartFolders()).find((s) => s.id === q.view.slice(3)) : null;
      const preset = q.view.startsWith('p:') ? presetOf(q.view.slice(2)) : undefined;
      ids = await idsForQuery(q, places, smart, preset?.ids ? await preset.ids() : null);
    }
    // Original folders of 未归档 (dragged or chosen whole): the files in them still to organize, which keep
    // the folders from that one down when moved.
    const dirs = form.getAll('dirs').map(String);
    if (dirs.length) {
      const inDirs = await idsInDirs(dirs);
      ids = [...new Set([...ids, ...inDirs.keys()])];
      if (action.action === 'move') action.bases = new Map([...inDirs].map(([id, dir]) => [id, dir.split('/').slice(0, -1).join('/')]));
    }
    if (ids.length === 0) throw new UserError('没有选中文件');
    const r = await applyInboxAction(actor, ids, action, t);
    if (r.plan) return new Response(JSON.stringify({ ok: true, msg: planMessage(r, t), batch: null }), { headers: { 'content-type': 'application/json' } });
    const msg = action.action === 'rename' && !r.changed ? t('没有改动') : resultMessage(r, ['delete', 'discard', 'note', 'rename'].includes(action.action), t);
    if (wantsJson) return new Response(JSON.stringify({ ok: true, msg, batch: r.batchId, changed: r.changed }), { headers: { 'content-type': 'application/json' } });
    // 「放入指定位置」 on the upload page: on to the place the files went.
    const then = places.canonical(String(form.get('then') ?? ''));
    if (then && then.startsWith('fd:')) return Astro.redirect(withParams(new URL(`/admin/inbox?loc=${then}&sub=1`, url), { msg, undo: r.batchId }), 303);
    return back({ msg, undo: r.batchId });
  } catch (e) {
    const err = errorText(e, t);
    if (wantsJson) return new Response(JSON.stringify({ ok: false, err }), { status: 400, headers: { 'content-type': 'application/json' } });
    return back({ err });
  }
}

// ---------------------------------------------------------------- what to show
const places = await Places.load();
const q: DeskQuery = readDeskQuery(url.searchParams, places);
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const smartFolders = await loadSmartFolders();
const smart = q.view.startsWith('sf:') ? smartFolders.find((s) => s.id === q.view.slice(3)) ?? null : null;
const preset = q.view.startsWith('p:') ? presetOf(q.view.slice(2)) : undefined;
const folder = q.loc ? places.folderOf(q.loc) ?? null : null;
const presetIds = preset?.ids ? await preset.ids() : null;
const w = deskWhere(q, places, smart, presetIds);
// 未归档 opened like a folder: the original folders below the open one come first.
const browse = browsing(q);
const srcDirs = browse ? (await sourceChildren(q.dir)).dirs : [];
// What the open original folder holds to organize, at any depth (the inspector's count).
const browseTotals = browse
  ? await (() => {
    const u = underDir(q.dir);
    return database.prepare(`SELECT count(*) AS n, coalesce(sum(size), 0) AS bytes FROM files WHERE ${UNPLACED_SQL} AND ${u.sql}`).bind(...u.binds).first<{ n: number; bytes: number }>();
  })()
  : null;
// 已归档 at its top lists only folders.
const atTop = !q.loc && q.view === ARCHIVE_VIEW;
const listsFiles = q.view !== 'trash' && !atTop && !preset?.editions;

type Row = Pick<
  FileRow,
  'id' | 'dir' | 'name' | 'download_name' | 'ext' | 'size' | 'kind' | 'rights' | 'state' | 'release_id' | 'edition_id' | 'folder_id' | 'slot' | 'suggest' | 'note'
  | 'sha256' | 'format' | 'origin' | 'dup_of' | 'sealed' | 'role' | 'blob_key' | 'created_at'
> & { copies: number; same_audio: number; gone: number; old: number; recordings: number };

const [totals, rowsResult, counts, tree, quick, problems, forms] = await Promise.all([
  listsFiles
    ? database.prepare(`SELECT count(*) AS n, coalesce(sum(size), 0) AS bytes FROM files ${w.sql}`).bind(...w.binds).first<{ n: number; bytes: number }>()
    : Promise.resolve({ n: 0, bytes: 0 }),
  listsFiles
    ? database
      .prepare(
        `SELECT id, dir, name, download_name, ext, size, kind, rights, state, release_id, edition_id, folder_id, slot, suggest, note, sha256, format,
                origin, dup_of, sealed, role, blob_key, created_at, ${originalGone('files')} AS gone,
                EXISTS (SELECT 1 FROM files n WHERE n.replaces = files.id) AS old,
                CASE WHEN sha256 IS NULL THEN 1 ELSE (SELECT count(*) FROM files f2 WHERE f2.sha256 = files.sha256) END AS copies,
                CASE WHEN pcm_md5 IS NULL THEN 1
                     ELSE (SELECT count(DISTINCT sha256) FROM files f3 WHERE f3.pcm_md5 = files.pcm_md5) END AS same_audio,
                CASE WHEN sha256 IS NULL THEN 0
                     ELSE (SELECT count(*) FROM acoustic_matches m WHERE m.a = files.sha256 OR m.b = files.sha256) END AS recordings
         FROM files ${w.sql} ORDER BY ${deskOrder(q)} LIMIT ? OFFSET ?`,
      )
      .bind(...w.binds, PAGE_SIZE, (page - 1) * PAGE_SIZE)
      .all<Row>()
    : Promise.resolve({ results: [] as Row[] }),
  partial ? Promise.resolve(null) : viewCounts(),
  folderTree(places, t),
  loadQuickAccess(actor),
  partial && !preset?.editions ? Promise.resolve(new Map<string, EditionProblem[]>()) : editionProblems(),
  partial ? Promise.resolve(null) : loadForms(),
]);
const rows = rowsResult.results;
const total = totals?.n ?? 0;
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Thumbnails for pictures and videos in the list (the processing program's WebP previews and posters), and
// for audio the cover it carries.
const media = rows.filter((r) => r.kind === 'image' || r.kind === 'video');
const audio = rows.filter((r) => r.kind === 'audio');
const [derived, covers] = await Promise.all([
  media.length ? derivedFor(database, media.map((r) => r.sha256)) : Promise.resolve(new Map()),
  audio.length ? audioThumbs(audio.map((r) => r.sha256)) : Promise.resolve(new Map<string, string>()),
]);
// Audio whose pictures were not read yet is read after the page has gone out (covers show next time).
const unreadAudio = audio.filter((r) => r.sha256 && !covers.has(r.sha256) && parseFormat(r.format).cover).map((r) => r.sha256);
if (unreadAudio.length) Astro.locals.cfContext?.waitUntil(readNow(database, env.MEDIA, unreadAudio, 25_000).catch(() => 0));
const thumbOf = (r: Row): string | null => {
  if (r.kind === 'audio') return (r.sha256 && covers.get(r.sha256)) || null;
  const d = r.sha256 ? derived.get(r.sha256) : undefined;
  if (r.kind === 'image') return imageSrc(r.blob_key ? `/admin/media/${r.blob_key}` : null, d, 240);
  if (r.kind === 'video') {
    const poster = d?.get('poster');
    return poster ? `/admin/media/${poster.key}` : null;
  }
  return null;
};
// A folder of mostly pictures opens as a grid (the page's script remembers the admin's own choice per folder).
const layout = (q.loc || browse) && rows.length > 0 && media.length / rows.length > 0.6 ? 'grid' : 'list';

// The tree: open on the way to the open folder; nodes by key for counts; editions with problems.
const byKey = new Map<string, LocNode>();
const index = (nodes: LocNode[]) => nodes.forEach((n) => { byKey.set(n.key, n); index(n.children); });
index(tree);
const open = new Set(q.loc ? places.chain(q.loc) : []);
const editionOfFolder = new Map([...places.folders.values()].filter((f) => f.edition_id).map((f) => [f.id, f.edition_id!]));
const problemTexts = new Map([...problems].map(([id, list]) => [id, list.map((p) => EDITION_PROBLEMS[p])]));
const quickFolders = quick.map((id) => places.folders.get(id)).filter((f) => !!f);

const [trash, problemEditions, openFolder, readme] = await Promise.all([
  q.view === 'trash' ? trashBatches(graceDays(env.STORAGE_GRACE_DAYS)) : Promise.resolve([]),
  Promise.resolve(preset?.editions ? [...problems].map(([id, list]) => ({ folder: places.editionFolder(id), list })).filter((e) => !!e.folder) : []),
  folder ? folderView(places, folder.id, t, quick.includes(folder.id)) : Promise.resolve(null),
  folder?.readme_file_id ? database.prepare('SELECT id, name, blob_key FROM files WHERE id = ?').bind(folder.readme_file_id).first<{ id: string; name: string; blob_key: string | null }>() : Promise.resolve(null),
]);

// ---------------------------------------------------------------- names and links
const viewName = (view: string): string => {
  if (view === 'all') return t('全部');
  if (view === 'unplaced') return t('未归档');
  if (view === 'suggested') return t('可按建议归档');
  if (view === 'ignored') return t('已忽略');
  if (view === 'trash') return t('回收站');
  if (view === ARCHIVE_VIEW) return t('已归档');
  if (view.startsWith('p:')) return t(presetOf(view.slice(2))?.name ?? view);
  if (view.startsWith('sf:')) return smartFolders.find((s) => s.id === view.slice(3))?.name ?? t('智能文件夹');
  return view;
};
const title = folder ? places.folderName(folder, t) : q.view === 'unplaced' && q.dir ? q.dir.split('/').at(-1)! : viewName(q.view);
const here = (params: Record<string, string | null>) => withParams(url, { page: null, msg: null, err: null, undo: null, ...params });
const folderHref = (key: string) => `/admin/inbox?loc=${key}`;
const viewHref = (view: string) => `/admin/inbox?view=${encodeURIComponent(view)}`;
const dirParts = q.dir ? q.dir.split('/') : [];
const ruleText = (set: RuleSet) =>
  set.rules.map((r) => {
    const field = RULE_FIELDS[r.field];
    let value = r.value ?? '';
    if (field?.value === 'kind') value = t(FILE_KIND_LABELS[value] ?? value);
    if (field?.value === 'rights') value = t(RIGHTS_LABELS[value as keyof typeof RIGHTS_LABELS] ?? value);
    if (field?.value === 'state') value = t(FILE_STATE_LABELS[value as keyof typeof FILE_STATE_LABELS] ?? value);
    if (field?.value === 'origin') value = t(ORIGINS[value as keyof typeof ORIGINS] ?? value);
    if (field?.value === 'suggest') value = t(SUGGEST_KINDS[value as keyof typeof SUGGEST_KINDS] ?? value);
    if (field?.value === 'release') value = places.releaseLabel(value);
    if (field?.value === 'folder') value = places.path(`fd:${value}`, t) || value;
    return `${t(field?.label ?? r.field)} ${t(RULE_OPS[r.op] ?? r.op)} ${value}`.trim();
  });

// Rows come in groups: by original folder when sorted by path, by suggested release in 可按建议归档.
const groups: { key: string; label: string; href: string | null; rows: Row[] }[] = [];
for (const row of rows) {
  const s = parseSuggestion(row.suggest);
  const key = q.view === 'suggested' ? s?.release_id ?? '' : q.sort === 'path' ? row.dir : '';
  const last = groups.at(-1);
  if (last && last.key === key) {
    last.rows.push(row);
    continue;
  }
  if (q.view === 'suggested') {
    groups.push({ key, rows: [row], href: key ? `/admin/releases/${key}` : null, label: key ? t('建议：{release}', { release: places.releaseLabel(key) }) : t('没有作品建议') });
  } else if (q.sort === 'path') {
    groups.push({ key, label: row.dir || t('（根目录）'), href: here({ dir: row.dir, loc: null, view: q.loc ? 'all' : q.view, sub: q.view === 'unplaced' ? null : url.searchParams.get('sub'), q: q.view === 'unplaced' ? null : url.searchParams.get('q') }), rows: [row] });
  } else groups.push({ key, label: '', href: null, rows: [row] });
}

/** What a suggestion would do, in words (the place is only named: editions and folders are made on accept). */
function suggestionPlace(s: Suggestion): string | null {
  const parts: string[] = [];
  if (s.place) parts.push(places.path(s.place, t) || s.place);
  else if (s.release_id) parts.push(places.releaseLabel(s.release_id));
  else if (s.era_id) parts.push(places.eras.get(s.era_id)?.name ?? s.era_id);
  if (s.slot) parts.push(places.editionLabel({ slot: s.slot, name: s.edition ?? '' }, t));
  if (s.folder) parts.push(s.folder.split('/').join(' / '));
  return parts.length ? parts.join(' / ') : null;
}
const placeOf = (r: Row) => places.keyOf(r);
/** The folder's own name, or «release / edition» for an edition (the full path is in the tooltip). */
const shortPath = (key: string) => {
  const chain = places.chain(key);
  const last = places.folderOf(chain.at(-1)!);
  return last?.edition_id ? chain.slice(-2).map((k) => places.name(k, t)).join(' / ') : places.name(chain.at(-1)!, t);
};
const subfolders = folder ? places.children(folder.id) : atTop ? places.children(null) : [];
const showPlace = !q.loc || q.sub;

// Everything the page's script needs to know about the tree (for the picker, drag and drop and menus).
const viewData = { loc: q.loc, view: q.view, dir: q.dir, sub: q.sub, browse, total, layout };
const deskData = partial ? { ...viewData, partial: true } : {
  ...viewData,
  folders: places.options(t).map((o) => {
    const f = places.folders.get(o.id)!;
    return { id: o.id, parent: o.parent, kind: o.kind, name: o.name, raw: places.rawName(f), path: o.path, depth: o.depth, release: f.release_id ?? undefined, edition: f.edition_id ?? undefined };
  }),
  quick,
  smart: smartFolders.map((s) => ({ id: s.id, name: s.name, rules: s.rules })),
  releases: [...places.releases.values()].map((r) => ({ id: r.id, label: places.releaseLabel(r.id) })).sort((a, b) => a.label.localeCompare(b.label, 'ja')),
  ruleFields: Object.entries(RULE_FIELDS).map(([id, f]) => ({ id, label: t(f.label), ops: f.ops, value: f.value })),
  ruleOps: Object.fromEntries(Object.entries(RULE_OPS).map(([k, v]) => [k, t(v)])),
  kinds: Object.entries(FILE_KIND_LABELS).map(([id, label]) => ({ id, label: t(label) })),
  rights: RIGHTS.map((id) => ({ id, label: t(RIGHTS_LABELS[id]) })),
  states: FILE_STATES.map((id) => ({ id, label: t(FILE_STATE_LABELS[id]) })),
  origins: Object.entries(ORIGINS).map(([id, label]) => ({ id, label: t(label) })),
  suggestKinds: Object.entries(SUGGEST_KINDS).map(([id, label]) => ({ id, label: t(label) })),
  guess: Object.fromEntries([...places.folders.values()].filter((f) => f.type === 'plain').map((f) => [f.id, guessRelease(f.name)])),
  slots: places.types.options(t),
};
const statusText: Record<string, string> = { missing: '缺档', partial: '部分缺档', planned: '预定', unknown: '待确认' };
// 已整理 = placed, published or ignored (files kept whole inside an archive do not count).
const done = counts ? counts.all - counts.unplaced : 0;
const Page = partial ? Bare : Admin;
---

<Page title={t('整理台')} wide>
  <div id="desk" class="desk" data-loc={q.loc} data-view={q.view} data-layout={layout}>
    {!partial && counts && forms && (
    <aside id="desk-side" class="desk-side" aria-label={t('位置')}>
      {/* 视图, 快速访问 and 智能文件夹 fold away with their triangle (remembered in this browser), leaving the trees more room. */}
      <nav class="side-sec fixed" data-sec="views">
        <h3>
          <button type="button" class="sec-toggle" data-act="toggle-sec" data-sec="views" aria-expanded="true">{t('视图')}</button>
          <span class="sec-note" title={t('已整理 = 已归档、已发布或已忽略')}>{t('已整理 {pct}', { pct: percent(counts.all ? done / counts.all : 0) })}</span>
        </h3>
        <div class="sec-body">
          {FIXED_VIEWS.filter((v) => v !== 'unplaced').map((v) => (
            <a class:list={['entry', { current: !q.loc && q.view === v && !q.dir }]} href={viewHref(v)} data-nav data-view={v} data-drop={v === 'ignored' || v === 'trash' ? v : undefined}>
              <span>{viewName(v)}</span>
              {v !== 'trash' && <span class="n">{counts[v as Exclude<typeof v, 'trash'>]}</span>}
            </a>
          ))}
          <div class="progress mini" title={t('已整理 = 已归档、已发布或已忽略')}>
            <div class="bar"><span style={`width:${counts.all ? (done / counts.all) * 100 : 0}%`}></span></div>
          </div>
        </div>
      </nav>

      <section class="side-sec quick" data-drop="quick" data-sec="quick">
        <h3><button type="button" class="sec-toggle" data-act="toggle-sec" data-sec="quick" aria-expanded="true">{t('快速访问')}</button></h3>
        <div class="sec-body">
        {quickFolders.length === 0 && <p class="muted small">{t('右键文件夹「加入快速访问」，或把文件夹拖到这里。')}</p>}
        <ul>
          {quickFolders.map((f) => (
            <li>
              <div class:list={['frow', 'quick-row', { current: q.loc === folderKey(f!.id) }]} data-folder={f!.id} data-kind={f!.type} data-drop="folder" data-quick draggable="true">
                <FolderIcon kind={f!.type} color={f!.color} />
                <a class="fname" href={folderHref(folderKey(f!.id))} data-nav title={places.path(folderKey(f!.id), t)}>{places.folderName(f!, t)}</a>
                <span class="n">{byKey.get(folderKey(f!.id))?.n || ''}</span>
              </div>
            </li>
          ))}
        </ul>
        </div>
      </section>

      <section class="side-sec tree-sec src-sec" aria-label={t('未归档')}>
        <h3>
          <a class:list={['sec-link', { current: browse && !q.dir }]} href={viewHref('unplaced')} data-nav data-view="unplaced" data-drop="unplaced" title={t('还没归档的文件，按原始文件夹排列；把文件拖到这里就是退回未归档')}>
            {t('未归档')} <span class="n">{counts.unplaced}</span>
          </a>
        </h3>
        <ul class="ftree" role="tree" data-src-tree data-n={counts.unplaced}></ul>
        {counts.unplaced === 0 && <p class="muted small tree-empty">{t('全部整理完了。')}</p>}
      </section>
      <div class="tree-split" role="separator" aria-orientation="horizontal" tabindex="0" aria-label={t('调整两棵树的高度')} title={t('上下拖动调整两棵树的高度，双击恢复')}></div>

      <section class="side-sec tree-sec folders" data-drop="top">
        <h3>
          <a class:list={['sec-link', { current: atTop }]} href={viewHref(ARCHIVE_VIEW)} data-nav data-view={ARCHIVE_VIEW} title={t('整理好的文件夹：名义、作品、版本和普通文件夹')}>{t('已归档')}</a>
          <span>
            <button type="button" class="icon-button" data-act="expand-all" title={t('展开或收起全部（*）')} aria-label={t('展开或收起全部')}>⇕</button>
            <button type="button" class="icon-button" data-act="new-folder" data-under="top" title={t('在顶层新建文件夹')} aria-label={t('在顶层新建文件夹')}>＋</button>
          </span>
        </h3>
        <FolderTree nodes={tree} current={q.loc} open={open} problems={problemTexts} editions={editionOfFolder} />
      </section>

      <section class="side-sec smart" data-sec="smart">
        <h3>
          <button type="button" class="sec-toggle" data-act="toggle-sec" data-sec="smart" aria-expanded="true">{t('智能文件夹')}</button>
          <button type="button" class="icon-button" data-act="smart-new" title={t('新建智能文件夹')} aria-label={t('新建智能文件夹')}>＋</button>
        </h3>
        <div class="sec-body">
        <ul>
          {smartFolders.map((s) => (
            <li><a class:list={['entry', { current: q.view === `sf:${s.id}` }]} href={viewHref(`sf:${s.id}`)} data-nav data-smart={s.id}><span class="sf-icon" aria-hidden="true">⚙</span>{s.name}</a></li>
          ))}
        </ul>
        <details class="presets" open={!!preset}>
          <summary class="muted small">{t('预设（{n}）', { n: PRESETS.length })}</summary>
          <ul>
            {PRESETS.map((p) => (
              <li><a class:list={['entry', { current: q.view === `p:${p.key}` }]} href={viewHref(`p:${p.key}`)} data-nav title={t(p.hint)}><span class="sf-icon" aria-hidden="true">⚙</span>{t(p.name)}</a></li>
            ))}
          </ul>
        </details>
        </div>
      </section>

    </aside>
    )}

    <section id="desk-main" class="desk-main">
      <header id="desk-top" class="desk-top">
        <button type="button" class="icon-button pane-toggle" data-act="toggle-side" aria-pressed="true" title={t('收起或展开左栏（[）')} aria-label={t('左栏')}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path class="pane-fill" d="M4.5 3.5h3v13h-3a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z" /><rect x="2.5" y="3.5" width="15" height="13" rx="2" /><path d="M7.5 3.5v13" /></svg>
        </button>
        <nav class="crumbs" aria-label={t('位置')}>
          {folder ? (
            <>
              <a href={viewHref(ARCHIVE_VIEW)} data-nav class="crumb-root">{t('已归档')}</a>
              {places.chain(q.loc).map((k) => (
                <> <span class="sep">›</span> <a href={folderHref(k)} data-nav data-drop="folder" data-folder={split(k)[1]}>{places.name(k, t)}</a></>
              ))}
            </>
          ) : q.view === 'unplaced' ? (
            <>
              <a href={viewHref('unplaced')} data-nav data-drop="unplaced" class="crumb-root">{t('未归档')}</a>
              {dirParts.map((part, i) => (
                <> <span class="sep">›</span> <a href={`/admin/inbox?view=unplaced&dir=${encodeURIComponent(dirParts.slice(0, i + 1).join('/'))}`} data-nav>{part}</a></>
              ))}
            </>
          ) : (
            <a href={viewHref(q.view)} data-nav>{viewName(q.view)}</a>
          )}
          {dirParts.length > 0 && q.view !== 'unplaced' && (
            <span class="dir-crumbs" title={t('按来源浏览')}>
              <span class="sep">·</span> {t('来源：')}
              {dirParts.map((part, i) => <>{i > 0 && ' / '}<a href={here({ dir: dirParts.slice(0, i + 1).join('/') })} data-nav>{part}</a></>)}
              <a href={here({ dir: null })} data-nav class="clear" title={t('不限来源')} aria-label={t('不限来源')}>×</a>
            </span>
          )}
        </nav>
        <form class="search" method="get" action="/admin/inbox" data-search>
          {q.loc && <input type="hidden" name="loc" value={q.loc} />}
          {!q.loc && <input type="hidden" name="view" value={q.view} />}
          {q.dir && <input type="hidden" name="dir" value={q.dir} />}
          {q.sub && <input type="hidden" name="sub" value="1" />}
          <input type="search" name="q" value={q.q} placeholder={folder || (q.view === 'unplaced' && q.dir) ? t('在这个文件夹里搜索') : t('在这里搜索文件名或路径')} aria-label={t('搜索')} />
        </form>
        <div class="top-tools">
          <label class="small">{t('排序')}
            <select data-param="sort">
              {([['name', '名称'], ['path', '原始路径'], ['size', '大小'], ['date', '加入时间'], ['kind', '类型']] as const).map(([v, label]) => <option value={v} selected={q.sort === v}>{t(label)}</option>)}
            </select>
          </label>
          <button type="button" class="icon-button" data-act="sort-dir" data-desc={q.desc ? '1' : '0'} title={q.desc ? t('从大到小') : t('从小到大')} aria-label={t('排序方向')}>{q.desc ? '↓' : '↑'}</button>
          <span class="seg" role="group" aria-label={t('视图')}>
            <button type="button" data-act="layout" data-layout="list" title={t('列表')} aria-label={t('列表')}>☰</button>
            <button type="button" data-act="layout" data-layout="grid" title={t('网格')} aria-label={t('网格')}>▦</button>
          </span>
          {(folder || (q.view === 'unplaced' && !q.q)) && (
            <label class="small sub-toggle"><input type="checkbox" data-act="sub" checked={q.sub} /> {t('显示子文件夹内容')}</label>
          )}
          <button type="button" class="icon-button" data-act="help" title={t('快捷键（?）')} aria-label={t('快捷键')}>?</button>
          <button type="button" class="icon-button pane-toggle" data-act="toggle-insp" aria-pressed="true" title={t('收起或展开右栏（]）')} aria-label={t('右栏')}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path class="pane-fill" d="M12.5 3.5h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3z" /><rect x="2.5" y="3.5" width="15" height="13" rx="2" /><path d="M12.5 3.5v13" /></svg>
          </button>
        </div>
      </header>

      <div id="desk-content" class="desk-content" tabindex="-1">
        {folder?.description && <p class="folder-note">{folder.description}</p>}
        {readme && (
          <div class="readme">
            <div class="muted small">{t('说明文件：')}<a href={`/admin/files/${readme.id}`}>{readme.name}</a></div>
            {readme.blob_key && (
              <div data-text-src={`/admin/media/${readme.blob_key}`}>
                <select hidden><option value="auto" selected>auto</option></select><span data-detected hidden></span>
                <pre>{t('读取中…')}</pre>
              </div>
            )}
          </div>
        )}
        {preset && !preset.editions && <p class="view-note muted">{t(preset.hint)}{preset.link && <> · <a href={preset.link.href}>{t(preset.link.label)} ›</a></>}</p>}

        {listsFiles && (rows.length > 0 || subfolders.length > 0 || srcDirs.length > 0) && (
          <div class="items-head" aria-hidden="true">
            <span></span>
            <span></span>
            <a href={here({ sort: 'name', desc: q.sort === 'name' && !q.desc ? '1' : null })} data-nav>{t('名称')}</a>
            <a href={here({ sort: 'size', desc: q.sort === 'size' && !q.desc ? '1' : null })} data-nav class="num">{t('大小')}</a>
            <span>{t('规格')}</span>
            <span>{showPlace ? t('建议 / 位置') : t('建议')}</span>
            <span></span>
          </div>
        )}

        {(folder || atTop) && (
          <div class="tiles" role="list" aria-label={t('子文件夹')}>
            {subfolders.map((f) => {
              const node = byKey.get(folderKey(f.id));
              return (
                <div class:list={['tile', 'item-folder']} role="listitem" tabindex="-1" data-folder={f.id} data-kind={f.type} data-drop="folder" draggable="true">
                  <FolderIcon kind={f.type} color={f.color} size={28} />
                  <a class="tname" href={folderHref(folderKey(f.id))} data-nav tabindex="-1">{places.folderName(f, t)}</a>
                  <span class="muted small">
                    {t('{n} 个', { n: node?.n ?? 0 })}
                    {node?.status && statusText[node.status] && <span class={`chip ${node.status}`}>{t(statusText[node.status])}</span>}
                  </span>
                  <button type="button" class="more" data-act="menu" aria-label={t('更多操作')} tabindex="-1">⋯</button>
                </div>
              );
            })}
            <button type="button" class="tile new" data-act="new-folder" data-under={q.loc || 'top'} title="Ctrl+Shift+N">
              <span aria-hidden="true">＋</span> {t('新建文件夹')}
            </button>
          </div>
        )}

        {srcDirs.length > 0 && (
          <div class="tiles" role="list" aria-label={t('子文件夹')}>
            {srcDirs.map((d) => (
              <div class="tile item-folder" role="listitem" tabindex="-1" data-src={d.path} draggable="true" title={d.path}>
                <FolderIcon kind="plain" size={28} />
                <a class="tname" href={`/admin/inbox?view=unplaced&dir=${encodeURIComponent(d.path)}`} data-nav tabindex="-1">{d.name}</a>
                <span class="muted small">{t('{n} 个', { n: d.n })}</span>
                <button type="button" class="more" data-act="menu" aria-label={t('更多操作')} tabindex="-1">⋯</button>
              </div>
            ))}
          </div>
        )}

        {q.view === 'trash' && (
          <div class="trash">
            <p class="muted">{t('最近删除的文件。存储里的内容保留 {days} 天，在此之前「恢复」就是撤销那次删除。', { days: graceDays(env.STORAGE_GRACE_DAYS) })}</p>
            {trash.length === 0 && <p class="empty">{t('回收站是空的。')}</p>}
            {trash.map((b) => (
              <div class="trash-row panel">
                <div>
                  <b>{summaryText(b.summary, t)}</b>
                  <div class="muted small">{b.at.slice(0, 16).replace('T', ' ')} · {b.actor} · {formatBytes(b.bytes)}</div>
                  <div class="small">{b.names}</div>
                </div>
                <button type="button" data-act="undo" data-batch={b.batch_id}>{t('恢复')}</button>
              </div>
            ))}
          </div>
        )}

        {preset?.editions && (
          <div class="tiles problems">
            <p class="view-note muted">{t(preset.hint)}</p>
            {problemEditions.length === 0 && <p class="empty">{t('没有问题。')}</p>}
            {problemEditions.map(({ folder: f, list }) => (
              <div class="tile wide-tile" tabindex="-1" data-folder={f!.id} data-kind="edition" data-drop="folder" draggable="true">
                <FolderIcon kind="edition" color={f!.color} size={28} />
                <a class="tname" href={folderHref(folderKey(f!.id))} data-nav>{places.path(folderKey(f!.id), t)}</a>
                <span class="small">{list.map((p: EditionProblem) => <span class="chip partial">{t(EDITION_PROBLEMS[p])}</span>)}</span>
              </div>
            ))}
          </div>
        )}

        {listsFiles && (
          <>
            <div class="items" role="listbox" aria-multiselectable="true" aria-label={t('文件')}>
              {groups.map((g) => (
                <>
                  {g.label && (
                    <div class="group">
                      <input type="checkbox" class="pick-group" aria-label={t('全选本组')} />
                      {g.href ? <a href={g.href} data-nav={g.href.startsWith('/admin/inbox') ? '' : undefined}>{g.label}</a> : g.label}
                      <span class="muted"> · {t('{n} 个', { n: g.rows.length })}</span>
                    </div>
                  )}
                  {g.rows.map((f) => {
                    const s = parseSuggestion(f.suggest);
                    const fmt = parseFormat(f.format);
                    const key = placeOf(f);
                    const sugPlace = s ? suggestionPlace(s) : null;
                    const thumb = thumbOf(f);
                    const archive = isArchive({ kind: f.kind, format: fmt });
                    const shown = f.download_name || f.name;
                    return (
                      <div class="item" role="option" aria-selected="false" tabindex="-1" draggable="true"
                        data-id={f.id} data-kind={f.kind} data-state={f.state} data-upload={f.origin === 'upload' ? '1' : undefined}
                        data-name={shown} data-orig={f.name} data-ext={f.ext} data-edition={f.edition_id ?? undefined} data-release={f.release_id ?? undefined}
                        data-archive={archive ? '1' : undefined} data-sealed={f.sealed ? '1' : undefined} data-sug={s && !key ? '1' : undefined}
                        data-placed={key ? '1' : undefined}>
                        <input type="checkbox" class="pick" tabindex="-1" aria-label={t('选中')} />
                        <div class="thumb">{thumb ? <img src={thumb} alt="" loading="lazy" /> : <span class={`kind-icon k-${f.kind}`}>{(f.ext || '?').slice(0, 4).toUpperCase()}</span>}</div>
                        <div class="iname">
                          <span class="fn" title={f.download_name ? t('原文件名：{name}', { name: f.name }) : shown}>{shown}</span>
                          <span class="chips">
                            {f.download_name && <span class="chip" title={t('原文件名：{name}', { name: f.name })}>{t('已改名')}</span>}
                            {f.sealed ? <span class="chip collected" title={t('整体收藏：包内文件不单独整理，只在文件页列出清单')}>{t('整体收藏')}</span> : null}
                            {f.old ? <span class="chip ignored" title={t('已上传新版本替换')}>{t('旧版本')}</span> : null}
                            {f.dup_of && <span class="chip ignored" title={t('标为重复，指向保留的那份')}>{t('重复')}</span>}
                            {f.origin === 'upload' && <span class="chip planned">{t('上传')}</span>}
                            {f.gone ? <span class="chip missing" title={t('最近一次导入时 source 里已没有这个文件，可以删除')}>{t('原件已不存在')}</span> : null}
                            {fmt.upload_error && <span class="chip missing" title={fmt.upload_error}>{t('上传内容有误')}</span>}
                            {f.copies > 1 && <span class="chip partial" title={t('SHA-256 相同的文件数')}>{t('重复 ×{n}', { n: f.copies })}</span>}
                            {f.same_audio > 1 && <span class="chip planned" title={t('解码后的音频完全相同、文件本身不同的版本数（如 WAV 与 FLAC，或只有标签不同）')}>{t('同音频 ×{n}', { n: f.same_audio })}</span>}
                            {f.recordings > 0 && <span class="chip ask" title={t('声学指纹比对：听起来是同一录音的其他文件数')}>{t('同录音 ×{n}', { n: f.recordings })}</span>}
                            {fmt.archive && <span class="chip">{t('包内 {n} 个', { n: fmt.files })}</span>}
                            {fmt.status && fmt.status !== 'ok' && <span class="chip missing" title={fmt.error}>{t(ARCHIVE_STATUS_LABELS[fmt.status] ?? fmt.status)}</span>}
                            {f.rights !== 'unknown' && <span class={`chip ${f.rights}`}>{t(RIGHTS_LABELS[f.rights])}</span>}
                            {f.role && ROLE_LABELS[f.role] && <span class="chip">{t(ROLE_LABELS[f.role])}</span>}
                          </span>
                          {f.note && <span class="muted small note">{f.note}</span>}
                          {!browse && (q.sort !== 'path' || q.view === 'suggested') && <span class="muted mono src-path" title={f.dir}>{f.dir}</span>}
                        </div>
                        <div class="isize">{formatBytes(f.size)}</div>
                        <div class="ispec" title={fmt.probe_error ?? formatSpec(fmt)}>{formatSpec(fmt)}</div>
                        <div class="isug" title={key ? places.path(key, t) : s ? [sugPlace, t('规则：{rule}', { rule: t(s.rule) }), percent(s.confidence)].filter(Boolean).join(' · ') : undefined}>
                          {key ? (
                            showPlace ? <a href={folderHref(key)} data-nav title={places.path(key, t)} class="place-link">{shortPath(key)}</a> : null
                          ) : s ? (
                            <>
                              {s.state === 'ignored' && <span class="chip ignored">{t('建议忽略')}</span>}
                              {sugPlace && <b>{sugPlace}</b>}
                              {s.seal && <span class="chip collected">{t('整体收藏')}</span>}
                              {s.rights && <span class={`chip ${s.rights}`}>{t(RIGHTS_LABELS[s.rights])}</span>}
                              <span class="rule" title={t('规则：{rule}', { rule: t(s.rule) })}>{percent(s.confidence)}</span>
                            </>
                          ) : (
                            <span class={`chip ${f.state}`}>{t(f.state === 'inbox' ? '未归档' : FILE_STATE_LABELS[f.state])}</span>
                          )}
                        </div>
                        <button type="button" class="more" data-act="menu" aria-label={t('更多操作')} tabindex="-1">⋯</button>
                      </div>
                    );
                  })}
                </>
              ))}
            </div>
            {total === 0 && srcDirs.length === 0 && (
              <div class="empty">
                {q.view === 'unplaced' && !q.dir && !q.q ? (
                  <p>{t('全部整理完了。')}</p>
                ) : browse ? (
                  <p class="muted">{t('这个文件夹里的文件都整理好了。')}</p>
                ) : folder && subfolders.length === 0 ? (
                  <p>{t('这个文件夹是空的：把文件拖到这里的文件夹上，或右键新建子文件夹。')}</p>
                ) : folder ? (
                  <p class="muted">{q.sub ? t('没有文件。') : t('文件都在子文件夹里；勾选「显示子文件夹内容」可以一起列出。')}</p>
                ) : (
                  <p class="muted">{t('没有符合条件的文件。')}</p>
                )}
              </div>
            )}
            {pages > 1 && (
              <div class="pager">
                {page > 1 && <a href={withParams(url, { page: page - 1 })} data-nav>{t('上一页')}</a>}
                <span>{t('第 {page} / {pages} 页', { page, pages })}</span>
                {page < pages && <a href={withParams(url, { page: page + 1 })} data-nav>{t('下一页')}</a>}
              </div>
            )}
          </>
        )}
      </div>

      <div id="desk-bar" class="desk-bar" hidden>
        <span class="count" set:html={t('已选 {n} 个', { n: '<b data-count>0</b>' })} />
        {listsFiles && total > 0 && <label class="small" title={t('改为当前列表全部 {n} 个文件', { n: total })}><input type="checkbox" data-scope-all /> <span>{t('改为当前列表全部 {n} 个文件', { n: total })}</span></label>}
        <span class="sep"></span>
        <button type="button" data-act="move-selection" title="M">{t('移动到…')}</button>
        <button type="button" class="primary" data-act="file-action" data-action="accept" title="A">{t('按建议归档')}</button>
        <button type="button" data-act="file-action" data-action="ignore" title="I">{t('忽略')}</button>
        <button type="button" data-act="menu-selection">{t('更多…')}</button>
        <button type="button" class="link" data-act="clear-selection">{t('取消选择')}</button>
      </div>
      <div id="desk-toast" class="desk-toast" role="status" aria-live="polite" hidden>
        <span data-text></span>
        <button type="button" data-act="undo-toast" hidden>{t('撤销')}</button>
        <button type="button" class="link" data-act="close-toast" aria-label={t('关闭')}>×</button>
      </div>
    </section>

    {!partial && <div class="desk-resize" data-resize="side" title={t('拖动调整宽度，双击恢复')} aria-hidden="true"></div>}
    {!partial && <div class="desk-resize" data-resize="insp" title={t('拖动调整宽度，双击恢复')} aria-hidden="true"></div>}
    <aside id="desk-inspector" class="desk-inspector" aria-label={t('详情')}>
      {openFolder ? (
        <Inspector mode="folder" places={places} view={openFolder} />
      ) : (
        <Inspector
          mode="view" title={title} hint={preset ? t(preset.hint) : q.view === 'unplaced' ? t('还没归档的文件，按原始文件夹排列。把文件或整个文件夹拖到左边「已归档」里的文件夹上即可归档；有规则建议的可以「按建议归档」。')
            : q.view === 'suggested' ? t('建议把握度在 50% 以上、还没归档的文件（批量「按建议归档」处理的就是这些），按建议的作品分组：勾选一组按 A 即可。')
            : atTop ? t('整理好的文件夹。名义、作品、版本都是带图标的文件夹，操作和普通文件夹一样。') : undefined}
          count={browseTotals?.n ?? total} bytes={browseTotals?.bytes ?? totals?.bytes ?? 0} link={preset?.link ? { href: preset.link.href, label: t(preset.link.label) } : null}
          smart={smart?.id ?? null} rules={smart ? ruleText(smart.rules) : []}
        />
      )}
    </aside>
  </div>

  {!partial && forms && (
    <>
      <div id="desk-menu" class="ctx-menu" role="menu" hidden></div>
      <div id="desk-drag" class="drag-label" hidden></div>
      <PlacePicker places={places} options={false} />
      <Dialogs types={places.types} forms={forms} />
    </>
  )}
  <script type="application/json" id="desk-data" set:html={JSON.stringify(deskData).replace(/</g, '\\u003c')} />
</Page>

<script>
  import { initDesk } from '../../scripts/desk';
  initDesk();
</script>

---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/db';
import { withParams } from '../../../lib/format';
import { errorText } from '../../../lib/i18n';
import { deleteOrphans, mergeCandidates, mergeSongs, versionsOf } from '../../../lib/songs';

const url = Astro.url;
const { t } = Astro.locals;
const actor = Astro.locals.admin!.email;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    let msg: string;
    if (form.get('action') === 'orphans') {
      const n = await deleteOrphans(actor);
      msg = n ? t('已删除 {n} 首没有曲目的单曲', { n }) : t('没有需要删除的单曲');
    } else {
      const target = String(form.get('target') ?? '');
      const n = await mergeSongs(actor, target, form.getAll('songs').map(String));
      msg = t('已合并（{n} 处改动）', { n });
    }
    return Astro.redirect(withParams(url, { msg, err: null }), 303);
  } catch (e) {
    return Astro.redirect(withParams(url, { err: errorText(e, t), msg: null }), 303);
  }
}

const q = (url.searchParams.get('q') ?? '').trim();
const database = db();
const [candidates, list, orphans] = await Promise.all([
  mergeCandidates(),
  database
    .prepare(
      `SELECT s.id, s.title, count(t.id) AS n, group_concat(coalesce(r.catalog_no, r.title), ' / ') AS releases
       FROM songs s LEFT JOIN tracks t ON t.song_id = s.id LEFT JOIN releases r ON r.id = t.release_id
       ${q ? 'WHERE instr(lower(s.title), lower(?)) > 0' : ''}
       GROUP BY s.id ORDER BY count(t.id) DESC, s.title LIMIT 300`,
    )
    .bind(...(q ? [q] : []))
    .all<{ id: string; title: string; n: number; releases: string | null }>(),
  database.prepare('SELECT count(*) AS n FROM songs s WHERE NOT EXISTS (SELECT 1 FROM tracks t WHERE t.song_id = s.id)').first<{ n: number }>(),
]);
const versions = await versionsOf(candidates.flatMap((g) => g.songs.map((s) => s.id)));
const bySong = new Map<string, typeof versions>();
for (const v of versions) bySong.set(v.song_id, [...(bySong.get(v.song_id) ?? []), v]);
---

<Admin title={t('单曲')}>
  <p class="muted">
    {t('每首曲目都属于一个单曲；同一首曲出现在不同作品里（专辑版、单曲版、DEMO、重制）时，把它们合并为一个单曲，单曲页就会按时间列出全部版本。曲目在作品页的「曲目表」里录入。')}
  </p>

  <h2>{t('合并候选（{n} 组）', { n: candidates.length })}</h2>
  <p class="muted">{t('候选来自三条线索：标题相同；文件解码后的音频完全相同；声学指纹判断为同一录音（不同母带、编码或剪辑）。')}</p>
  {candidates.length === 0 && <p class="muted">{t('没有同名、音频相同或同一录音的单曲。')}</p>}
  {
    candidates.map((g) => (
      <form method="post" class="panel">
        <p class="muted">{t('依据：{reasons}。勾选要合并的单曲，选一首保留（其余并入它）。', { reasons: g.reasons.map((r) => t(r)).join(t('、')) })}</p>
        <table class="grid">
          <thead><tr><th>{t('合并')}</th><th>{t('保留')}</th><th>{t('单曲')}</th><th>{t('版本')}</th></tr></thead>
          <tbody>
            {g.songs.map((s, i) => (
              <tr>
                <td><input type="checkbox" name="songs" value={s.id} checked /></td>
                <td><input type="radio" name="target" value={s.id} checked={i === 0} /></td>
                <td><a href={`/admin/songs/${s.id}`}>{s.title}</a></td>
                <td>
                  {(bySong.get(s.id) ?? []).map((v) => (
                    <div>
                      <a href={`/admin/releases/${v.release_id}#tracks`}>{v.catalog_no ?? v.release_title}</a>
                      <span class="muted"> {v.release_date ?? ''} · {v.disc > 1 ? `${v.disc}-` : ''}{v.position}. {v.title}{v.version_label ? `（${v.version_label}）` : ''}</span>
                    </div>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p><button class="primary" type="submit">{t('合并所选')}</button></p>
      </form>
    ))
  }

  <h2>{t('全部单曲')}</h2>
  <form class="filters" method="get">
    <label>{t('搜索')} <input type="search" name="q" value={q} placeholder={t('标题')} /></label>
    <button type="submit">{t('搜索')}</button>
  </form>
  <table class="grid">
    <thead><tr><th>{t('单曲')}</th><th class="num">{t('版本')}</th><th>{t('出现在')}</th></tr></thead>
    <tbody>
      {
        list.results.map((s) => (
          <tr>
            <td><a href={`/admin/songs/${s.id}`}>{s.title}</a></td>
            <td class="num">{s.n}</td>
            <td class="muted">{s.releases ?? t('（没有曲目）')}</td>
          </tr>
        ))
      }
      {list.results.length === 0 && <tr><td colspan="3" class="muted">{t('还没有单曲。在作品页录入曲目表后会自动生成。')}</td></tr>}
    </tbody>
  </table>
  {
    orphans && orphans.n > 0 && (
      <form method="post" class="panel">
        <input type="hidden" name="action" value="orphans" />
        {t('有 {n} 首单曲已经没有曲目（合并或删除曲目后留下的）。', { n: orphans.n })}
        <button type="submit">{t('删除它们')}</button>
      </form>
    )
  }
</Admin>

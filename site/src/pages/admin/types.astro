---
// 版本类型: the list of edition types (new, rename in three languages, order, whether the 缺档看板 lists
// them, delete). A type in use by an edition or by a pending suggestion cannot be deleted.
import Admin from '../../layouts/Admin.astro';
import { batchSince } from '../../lib/changes';
import { db } from '../../lib/db';
import { withParams } from '../../lib/format';
import { errorText, UserError } from '../../lib/i18n';
import { createType, deleteProblem, deleteType, loadTypes, reorderTypes, saveTypes, typeUses } from '../../lib/types';

const { t } = Astro.locals;

if (Astro.request.method === 'POST') {
  const started = new Date().toISOString();
  const form = await Astro.request.formData();
  const actor = Astro.locals.admin!.email;
  const saved = (n: number) => (n ? t('已保存（{n} 处改动）', { n }) : t('没有改动'));
  try {
    let msg: string;
    switch (form.get('section')) {
      case 'save':
        msg = saved(await saveTypes(actor, form));
        break;
      case 'create':
        await createType(actor, String(form.get('name') ?? ''));
        msg = t('已新建类型');
        break;
      case 'order':
        msg = saved(await reorderTypes(actor, String(form.get('order') ?? '').split(',').filter(Boolean)));
        break;
      case 'delete':
        await deleteType(actor, String(form.get('id') ?? ''), t);
        msg = t('已删除类型');
        break;
      default:
        throw new UserError('未知的表单');
    }
    const undo = await batchSince(db(), actor, started);
    return Astro.redirect(withParams(Astro.url, { msg, err: null, undo }), 303);
  } catch (e) {
    return Astro.redirect(withParams(Astro.url, { err: errorText(e, t), msg: null }), 303);
  }
}

const [types, uses] = await Promise.all([loadTypes(), typeUses()]);
---

<Admin title={t('版本类型')}>
  <p class="muted">
    {t('版本类型只用来给版本分类和排序（作品页与公开页里版本的先后、缺档看板的筛选）。每个作品有哪些版本、叫什么、有几个，都在作品页自己新建。')}
    <a href="/admin/releases">{t('← 作品')}</a>
  </p>

  <form method="post" class="panel" id="types-form">
    <input type="hidden" name="section" value="save" />
    <table class="grid types-table">
      <thead>
        <tr>
          <th></th><th>{t('中文名')}</th><th>{t('日文名')}</th><th>{t('英文名')}</th><th>{t('缺档看板')}</th>
          <th class="num">{t('版本')}</th><th class="num">{t('待确认的建议')}</th><th></th>
        </tr>
      </thead>
      <tbody id="types-body">
        {types.list.map((type) => {
          const use = uses.get(type.id);
          const problem = deleteProblem(use);
          return (
            <tr draggable="true" data-id={type.id}>
              <td class="handle" title={t('拖动排序')}>⠿<input type="hidden" name="id" value={type.id} /></td>
              <td><input type="text" name={`zh_${type.id}`} value={type.name_zh} maxlength="40" required /></td>
              <td><input type="text" name={`ja_${type.id}`} value={type.name_ja} maxlength="40" /></td>
              <td><input type="text" name={`en_${type.id}`} value={type.name_en} maxlength="40" /></td>
              <td><label class="inline-check"><input type="checkbox" name={`board_${type.id}`} value="1" checked={!!type.missing_board} /> {t('列出')}</label></td>
              <td class="num">{use?.editions ? <a href={`/admin/missing?type=${type.id}&status=all`}>{use.editions}</a> : 0}</td>
              <td class="num">{use?.suggestions ?? 0}</td>
              <td>
                <button type="submit" form={`del-${type.id}`} class="danger small" disabled={!!problem} title={problem ? errorText(problem, t) : t('删除这个类型（可在修改记录里撤销）')}>{t('删除')}</button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p>
      <button class="primary" type="submit">{t('保存名称与设置')}</button>
      <span class="muted">{t('日文名、英文名留空时用中文名。拖动 ⠿ 调整顺序后自动保存。')}</span>
    </p>
  </form>
  {types.list.map((type) => (
    <form method="post" id={`del-${type.id}`} hidden>
      <input type="hidden" name="section" value="delete" />
      <input type="hidden" name="id" value={type.id} />
    </form>
  ))}
  <form method="post" id="order-form" hidden>
    <input type="hidden" name="section" value="order" />
    <input type="hidden" name="order" value="" />
  </form>

  <h2>{t('新建类型')}</h2>
  <form method="post" class="panel inline-form">
    <input type="hidden" name="section" value="create" />
    <input type="text" name="name" maxlength="40" required placeholder={t('如「图片」「Bandcamp」「特典 DVD」')} />
    <button type="submit">{t('新建')}</button>
    <span class="muted">{t('也可以在作品页新建版本时，从类型下拉的「＋ 新类型…」直接新建。')}</span>
  </form>
</Admin>

<script>
  const body = document.querySelector<HTMLTableSectionElement>('#types-body');
  let dragged: HTMLTableRowElement | null = null;
  let before = '';
  const order = () => Array.from(body?.rows ?? []).map((r) => r.dataset.id).join(',');
  body?.addEventListener('dragstart', (e) => {
    dragged = (e.target as HTMLElement).closest('tr');
    before = order();
    dragged?.classList.add('dragging');
  });
  body?.addEventListener('dragover', (e) => {
    e.preventDefault();
    const over = (e.target as HTMLElement).closest('tr');
    if (!dragged || !over || over === dragged) return;
    const rect = over.getBoundingClientRect();
    body.insertBefore(dragged, e.clientY > rect.top + rect.height / 2 ? over.nextSibling : over);
  });
  body?.addEventListener('dragend', () => {
    dragged?.classList.remove('dragging');
    dragged = null;
    const now = order();
    if (now === before) return;
    const form = document.querySelector<HTMLFormElement>('#order-form')!;
    (form.elements.namedItem('order') as HTMLInputElement).value = now;
    form.submit();
  });
</script>
